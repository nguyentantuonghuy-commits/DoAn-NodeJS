doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "Atelier Accessories | Đẳng Cấp Phụ Kiện Thời Trang Đương Đại"
    meta(name="description", content="Thương hiệu phụ kiện thời trang đương đại hàng đầu: Thắt lưng da bò Ý, Ví da thủ công, Mũ nón streetwear, Kính mát phân cực UV400, Trang sức titan 316L chống gỉ. Thiết kế tinh tế lấy cảm hứng từ YaMe, Coolmate, Real Clothes & ACFC.")
    
    // Google Fonts (Plus Jakarta Sans & Playfair Display)
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap", rel="stylesheet")
    
    // Stylesheet
    link(rel="stylesheet", href="/css/style.css")
    
    // Lucide Icons
    script(src="https://unpkg.com/lucide@latest")

  body
    if currentPath && currentPath.startsWith('/admin')
      // Top Admin Bar
      header.admin-header-bar
        .admin-header-left(style="display: flex; align-items: center; gap: 14px;")
          a.brand-logo(href="/admin")
            .brand-logo-mark(style="width: 38px; height: 38px; font-size: 1.15rem; background: #1E293B; border: 1px solid rgba(255,255,255,0.1);")
              span.logo-icon A
            .brand-logo-text
              span.logo-main(style="font-size: 1.15rem; color: #FFF;") ATELIER
              span.logo-sub(style="font-size: 0.55rem; color: var(--accent-gold);") ADMIN SYSTEM
          span.admin-badge-pill HỆ THỐNG QUẢN TRỊ
        
        .admin-header-right(style="display: flex; align-items: center; gap: 16px;")
          a.btn.btn-sm(href="/", target="_blank", style="background: rgba(255,255,255,0.08); color: #FFF; border: 1px solid rgba(255,255,255,0.15); display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;")
            i(data-lucide="external-link", style="width: 14px; height: 14px;")
            | Xem Website
          if currentUser
            .admin-user-pill(style="display: flex; align-items: center; gap: 10px; color: #FFF;")
              img(src=currentUser.avatar, alt=currentUser.name, style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--accent-gold);")
              div(style="line-height: 1.2;")
                strong(style="display: block; font-size: 0.8125rem; color: #FFF;")= currentUser.name
                span(style="font-size: 0.7rem; color: #94A3B8;") Quản Trị Viên
          a.btn.btn-sm(href="/logout", style="background: rgba(225,29,72,0.15); color: #FDA4AF; border: 1px solid rgba(225,29,72,0.3); display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px;")
            i(data-lucide="log-out", style="width: 14px; height: 14px;")
            | Đăng Xuất
    else
      include ../partials/header

    // Main Page Content Injection
    main
      block content

    if !currentPath || !currentPath.startsWith('/admin')
      include ../partials/footer
    else
      footer.admin-footer
        p &copy; 2026 ATELIER ACCESSORIES - Bảng Điều Khiển Quản Trị Hệ Thống.
        p(style="color: #475569;") Phiên bản v2.4.0 (Pug SSR &amp; Node.js)

    // Global Toast Container
    .toast-container

    // Client Scripts
    script(src="/js/main.js")
    script.
      lucide.createIcons();
