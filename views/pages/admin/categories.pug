              //- Rendered dynamically via JS

        //- Modal Footer
        .modal-footer(style="padding: 10px 22px; background: #F8FAFC; border-top: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;")
          div(style="font-size: 0.78rem; color: #64748B;")
            | Nhấp 
            strong "Sửa" 
            | để cập nhật giá, kho hoặc biến thể sản phẩm.
          button.btn.btn-secondary(
            type="button",
            onclick="closeCategoryProductsModal()",
            style="padding: 7px 18px; font-size: 0.8125rem; font-weight: 600; background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 6px; color: #475569; cursor: pointer;"
          )
            | Đóng cửa sổ

  //- Modal CSS animation
  style.
    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: scale(0.96) translateY(-8px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

  script.
    // 1. Data Store from Server
    const allCategoriesData = !{JSON.stringify(categories)};
    let currentFilterStatus = 'all';

    function removeVietnameseTones(str) {
      if (!str) return '';
      str = String(str).toLowerCase();
      str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, 'a');
      str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, 'e');
      str = str.replace(/ì|í|ị|ỉ|ĩ/g, 'i');
      str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, 'o');
      str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, 'u');
      str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, 'y');
      str = str.replace(/đ/g, 'd');
      str = str.replace(/\u0300|\u0301|\u0303|\u0309|\u0323/g, '');
      return str.trim();
    }

    function autoGenerateSlug(text, targetInputId) {
      const target = document.getElementById(targetInputId);
      if (!target) return;
      const slug = removeVietnameseTones(text)
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      target.value = slug;
    }

    // 2. Real-time Instant Filter & Search (Gõ chữ nào tự động lọc danh mục đó)
    function filterCategories() {
      const rawQuery = (document.getElementById('catSearchInput')?.value || '').trim().toLowerCase();
      const normQuery = removeVietnameseTones(rawQuery);
      const clearBtn = document.getElementById('btnSearchClear');

      if (clearBtn) {
        clearBtn.style.display = rawQuery ? 'block' : 'none';
      }

      const rows = document.querySelectorAll('#categoriesTableBody tr.category-row');
      let visibleCount = 0;

      rows.forEach(r => {
        const name = r.dataset.name || '';
        const slug = r.dataset.slug || '';
        const desc = r.dataset.desc || '';
        const isHidden = r.dataset.hidden === 'true';

        // Search match
        let matchesSearch = true;
        if (rawQuery) {
          const normName = removeVietnameseTones(name);
          const normDesc = removeVietnameseTones(desc);
          matchesSearch = name.includes(rawQuery) || 
                          normName.includes(normQuery) || 
                          slug.includes(rawQuery) || 
                          desc.includes(rawQuery) || 
                          normDesc.includes(normQuery);
        }

        // Status match
        let matchesStatus = true;
        if (currentFilterStatus === 'visible') {
          matchesStatus = !isHidden;
        } else if (currentFilterStatus === 'hidden') {
          matchesStatus = isHidden;
        }

        if (matchesSearch && matchesStatus) {
          r.style.display = '';
          visibleCount++;
        } else {
          r.style.display = 'none';
        }
      });

      // Update match count text
      const matchText = document.getElementById('filterMatchText');
      if (matchText) {
        matchText.textContent = `Đang hiển thị ${visibleCount} trên tổng số ${rows.length} nhóm danh mục`;
      }

      // Empty state
      const emptyNotice = document.getElementById('emptySearchNotice');
      if (emptyNotice) {
        emptyNotice.style.display = (visibleCount === 0) ? 'block' : 'none';
      }
    }

    function clearSearchInput() {
      const input = document.getElementById('catSearchInput');
      if (input) {
        input.value = '';
        filterCategories();
        input.focus();
      }
    }

    function setFilterStatus(status) {
      currentFilterStatus = status;

      const pillAll = document.getElementById('pillAll');
      const pillVis = document.getElementById('pillVisible');
      const pillHid = document.getElementById('pillHidden');

      [pillAll, pillVis, pillHid].forEach(p => {
        if (p) {
          p.style.background = 'transparent';
          p.style.boxShadow = 'none';
        }
      });

      if (status === 'all' && pillAll) {
        pillAll.style.background = '#FFFFFF';
        pillAll.style.boxShadow = '0 1px 2px rgba(0,0,0,0.06)';
      } else if (status === 'visible' && pillVis) {
        pillVis.style.background = '#FFFFFF';
        pillVis.style.boxShadow = '0 1px 2px rgba(0,0,0,0.06)';
      } else if (status === 'hidden' && pillHid) {
        pillHid.style.background = '#FFFFFF';
        pillHid.style.boxShadow = '0 1px 2px rgba(0,0,0,0.06)';
      }

      filterCategories();
    }

    // 3. Image Upload Helpers
    function updateImagePreview(url, previewImgId, placeholderId) {
      const img = document.getElementById(previewImgId);
      const icon = document.getElementById(placeholderId);
      if (url && url.trim()) {
        if (img) {
          img.src = url.trim();
          img.style.display = 'block';
        }
        if (icon) icon.style.display = 'none';
      } else {
        if (img) {
          img.src = '';
          img.style.display = 'none';
        }
        if (icon) icon.style.display = 'block';
      }
    }

    async function handleImageFileUpload(input, targetInputId, targetPreviewId, targetPlaceholderId) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      const formData = new FormData();
      formData.append('image', file);

      try {
        showToast('Đang tải ảnh lên...', 'info');
        const res = await fetch('/api/products/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success && data.imageUrl) {
          const targetInput = document.getElementById(targetInputId);
          if (targetInput) targetInput.value = data.imageUrl;
          updateImagePreview(data.imageUrl, targetPreviewId, targetPlaceholderId);
          showToast('Đã tải ảnh lên thành công!', 'success');
        } else {
          showToast(data.message || 'Lỗi khi tải ảnh lên', 'error');
        }
      } catch (err) {
        showToast('Lỗi kết nối khi tải ảnh', 'error');
      }
      input.value = '';
    }

    // 4. Radio Status Choice Styling
    function setNewCategoryStatus(isHidden) {
      const rVis = document.getElementById('newRadioVisible');
      const rHid = document.getElementById('newRadioHidden');
      const lblVis = document.getElementById('lblNewVisOpen');
      const lblHid = document.getElementById('lblNewVisHidden');

      if (rVis) rVis.checked = !isHidden;
      if (rHid) rHid.checked = isHidden;

      if (isHidden) {
        if (lblHid) {
          lblHid.style.border = '1.5px solid #D97706';
          lblHid.style.background = '#FFFBEB';
          lblHid.style.color = '#B45309';
        }
        if (lblVis) {
          lblVis.style.border = '1.5px solid #E2E8F0';
          lblVis.style.background = '#FFFFFF';
          lblVis.style.color = '#64748B';
        }
      } else {
        if (lblVis) {
          lblVis.style.border = '1.5px solid #059669';
          lblVis.style.background = '#ECFDF5';
          lblVis.style.color = '#047857';
        }
        if (lblHid) {
          lblHid.style.border = '1.5px solid #E2E8F0';
          lblHid.style.background = '#FFFFFF';
          lblHid.style.color = '#64748B';
        }
      }
    }

    function setEditCategoryStatus(isHidden) {
      const rVis = document.getElementById('editRadioVisible');
      const rHid = document.getElementById('editRadioHidden');
      const lblVis = document.getElementById('lblEditVisOpen');
      const lblHid = document.getElementById('lblEditVisHidden');

      if (rVis) rVis.checked = !isHidden;
      if (rHid) rHid.checked = isHidden;

      if (isHidden) {
        if (lblHid) {
          lblHid.style.border = '1.5px solid #D97706';
          lblHid.style.background = '#FFFBEB';
          lblHid.style.color = '#B45309';
        }
        if (lblVis) {
          lblVis.style.border = '1.5px solid #E2E8F0';
          lblVis.style.background = '#FFFFFF';
          lblVis.style.color = '#64748B';
        }
      } else {
        if (lblVis) {
          lblVis.style.border = '1.5px solid #059669';
          lblVis.style.background = '#ECFDF5';
          lblVis.style.color = '#047857';
        }
        if (lblHid) {
          lblHid.style.border = '1.5px solid #E2E8F0';
          lblHid.style.background = '#FFFFFF';
          lblHid.style.color = '#64748B';
        }
      }
    }

    // 5. 1-Click Toggle Visibility (Ẩn / Hiện Tức Thì)
    async function toggleCategoryVisibility(id) {
      const btn = document.getElementById(`btn-vis-${id}`);
      const row = document.getElementById(`cat-row-${id}`);
      const badge = document.getElementById(`badge-hidden-${id}`);
      if (!btn) return;

      btn.disabled = true;
      btn.style.opacity = '0.6';

      try {
        const res = await fetch(`/api/categories/${id}/toggle-visibility`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (data.success && data.data) {
          const cat = data.data;
          const isHidden = cat.isHidden;

          // Update local data store
          const targetInStore = allCategoriesData.find(c => c.id === id);
          if (targetInStore) targetInStore.isHidden = isHidden;

          // Update Row Dataset
          if (row) row.dataset.hidden = isHidden ? 'true' : 'false';

          // Update Button UI
          if (isHidden) {
            btn.style.border = '1.5px solid #FCD34D';
            btn.style.background = '#FFFBEB';
            btn.style.color = '#B45309';
            btn.title = 'Bấm để MỞ BÁN lại trên website';
            btn.innerHTML = '<i data-lucide="eye-off" style="width: 14px; height: 14px; color: #D97706;"></i><span class="status-text">Đã Ẩn</span>';
            if (badge) badge.style.display = 'inline-flex';
          } else {
            btn.style.border = '1.5px solid #A7F3D0';
            btn.style.background = '#ECFDF5';
            btn.style.color = '#047857';
            btn.title = 'Bấm để TẠM ẨN khỏi website';
            btn.innerHTML = '<i data-lucide="eye" style="width: 14px; height: 14px; color: #059669;"></i><span class="status-text">Mở Bán</span>';
            if (badge) badge.style.display = 'none';
          }

          if (window.lucide) window.lucide.createIcons();
          updateHeaderStats();
          filterCategories();
          showToast(data.message, isHidden ? 'warning' : 'success');
        } else {
          showToast(data.message || 'Lỗi khi thay đổi trạng thái', 'error');
        }
      } catch (err) {
        showToast('Lỗi kết nối máy chủ', 'error');
      } finally {
        btn.disabled = false;
        btn.style.opacity = '1';
      }
    }

    function updateHeaderStats() {
      const rows = document.querySelectorAll('#categoriesTableBody tr.category-row');
      let act = 0;
      let hid = 0;
      rows.forEach(r => {
        if (r.dataset.hidden === 'true') hid++;
        else act++;
      });

      const sAct = document.getElementById('statActiveCount');
      const sHid = document.getElementById('statHiddenCount');
      const pVis = document.getElementById('pillCountVisible');
      const pHid = document.getElementById('pillCountHidden');

      if (sAct) sAct.textContent = `${act} Nhóm`;
      if (sHid) sHid.textContent = `${hid} Nhóm`;
      if (pVis) pVis.textContent = act;
      if (pHid) pHid.textContent = hid;
    }

    // 6. Modal 1: Create Category Modal Handlers
    function openCreateCategoryModal() {
      const modal = document.getElementById('createCategoryModal');
      if (modal) {
        modal.style.display = 'flex';
        const form = document.getElementById('createCategoryForm');
        if (form) form.scrollTop = 0;
        const body = modal.querySelector('.modal-body');
        if (body) body.scrollTop = 0;

        const nameInput = document.getElementById('newCatName');
        if (nameInput) {
          setTimeout(() => {
            if (form) form.scrollTop = 0;
            if (body) body.scrollTop = 0;
            nameInput.focus({ preventScroll: true });
          }, 60);
        }
      }
      if (window.lucide) window.lucide.createIcons();
    }

    function closeCreateCategoryModal() {
      const modal = document.getElementById('createCategoryModal');
      if (modal) modal.style.display = 'none';
    }

    async function handleCreateCategory(e) {
      e.preventDefault();
      const name = document.getElementById('newCatName').value.trim();
      const slug = document.getElementById('newCatSlug').value.trim();
      const icon = document.getElementById('newCatIcon').value;
      const order = Number(document.getElementById('newCatOrder').value) || 1;
      const image = document.getElementById('newCatImage').value.trim();
      const description = document.getElementById('newCatDesc').value.trim();
      const isHidden = document.getElementById('newRadioHidden').checked;

      if (!name) {
        showToast('Vui lòng nhập tên danh mục!', 'warning');
        document.getElementById('newCatName').focus({ preventScroll: true });
        return;
      }

      const btn = document.getElementById('btnSubmitCreate');
      const btnText = document.getElementById('btnCreateText');
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Đang tạo...';

      try {
        const res = await fetch('/api/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, slug, icon, order, image, description, isHidden })
        });
        const data = await res.json();

        if (data.success) {
          showToast('Tạo danh mục mới thành công!', 'success');
          setTimeout(() => location.reload(), 600);
        } else {
          showToast(data.message || 'Lỗi khi tạo danh mục', 'error');
          if (btn) btn.disabled = false;
          if (btnText) btnText.textContent = 'TẠO DANH MỤC MỚI';
        }
      } catch (err) {
        showToast('Có lỗi kết nối máy chủ', 'error');
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = 'TẠO DANH MỤC MỚI';
      }
    }

    // 7. Modal 2: Edit Category Modal Handlers
    function openEditCategoryModalById(id) {
      const cat = allCategoriesData.find(c => c.id === id);
      if (!cat) return;

      const modal = document.getElementById('editCategoryModal');
      const title = document.getElementById('editModalTitle');

      document.getElementById('editCatId').value = cat.id || '';
      document.getElementById('editCatName').value = cat.name || '';
      document.getElementById('editCatSlug').value = cat.slug || '';
      document.getElementById('editCatIcon').value = cat.icon || 'tag';
      document.getElementById('editCatOrder').value = cat.order || 1;
      document.getElementById('editCatImage').value = cat.image || '';
      document.getElementById('editCatDesc').value = cat.description || '';

      updateImagePreview(cat.image || '', 'editCatImgPreview', 'editCatImgPlaceholder');
      setEditCategoryStatus(!!cat.isHidden);

      if (title) title.textContent = `Chỉnh Sửa Danh Mục: ${cat.name}`;
      if (modal) {
        modal.style.display = 'flex';
        const form = document.getElementById('editCategoryForm');
        if (form) form.scrollTop = 0;
        const body = modal.querySelector('.modal-body');
        if (body) body.scrollTop = 0;

        const nameInput = document.getElementById('editCatName');
        if (nameInput) {
          setTimeout(() => {
            if (form) form.scrollTop = 0;
            if (body) body.scrollTop = 0;
            nameInput.focus({ preventScroll: true });
          }, 60);
        }
      }
      if (window.lucide) window.lucide.createIcons();
    }

    function closeEditCategoryModal() {
      const modal = document.getElementById('editCategoryModal');
      if (modal) modal.style.display = 'none';
    }

    async function handleUpdateCategory(e) {
      e.preventDefault();
      const id = document.getElementById('editCatId').value;
      const name = document.getElementById('editCatName').value.trim();
      const slug = document.getElementById('editCatSlug').value.trim();
      const icon = document.getElementById('editCatIcon').value;
      const order = Number(document.getElementById('editCatOrder').value) || 1;
      const image = document.getElementById('editCatImage').value.trim();
      const description = document.getElementById('editCatDesc').value.trim();
      const isHidden = document.getElementById('editRadioHidden').checked;

      if (!id || !name) {
        showToast('Vui lòng nhập tên danh mục!', 'warning');
        return;
      }

      const btn = document.getElementById('btnSubmitEdit');
      const btnText = document.getElementById('btnEditText');
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Đang lưu...';

      try {
        const res = await fetch(`/api/categories/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, slug, icon, order, image, description, isHidden })
        });
        const data = await res.json();

        if (data.success) {
          showToast('Cập nhật danh mục thành công!', 'success');
          setTimeout(() => location.reload(), 600);
        } else {
          showToast(data.message || 'Lỗi khi cập nhật danh mục', 'error');
          if (btn) btn.disabled = false;
          if (btnText) btnText.textContent = 'Lưu Thay Đổi';
        }
      } catch (err) {
        showToast('Có lỗi kết nối máy chủ', 'error');
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = 'Lưu Thay Đổi';
      }
    }

    // 8. Delete Category with Safety Warning Check
    async function deleteCategory(id, name, itemCount) {
      let confirmMsg = `Bạn có chắc chắn muốn xóa danh mục "${name}" không?`;
      if (itemCount > 0) {
        confirmMsg = `⚠️ CẢNH BÁO: Danh mục "${name}" hiện đang có ${itemCount} mẫu sản phẩm trong kho!\n\nNếu xóa danh mục này, các sản phẩm sẽ bị mất nhóm phân loại trên website.\n\nBạn có chắc chắn VẪN MUỐN XÓA danh mục này không?`;
      }

      if (!confirm(confirmMsg)) return;

      try {
        showToast('Đang xóa danh mục...', 'info');
        const res = await fetch(`/api/categories/${id}`, { method: 'DELETE' });
        const data = await res.json();

        if (data.success) {
          showToast(data.message || 'Đã xóa danh mục thành công!', 'success');
          const row = document.getElementById(`cat-row-${id}`);
          if (row) {
            row.style.transition = 'all 0.3s ease';
            row.style.opacity = '0';
            row.style.transform = 'translateX(20px)';
            setTimeout(() => {
              row.remove();
              updateHeaderStats();
              filterCategories();
            }, 300);
          } else {
            setTimeout(() => location.reload(), 600);
          }
        } else {
          showToast(data.message || 'Lỗi khi xóa danh mục', 'error');
        }
      } catch (err) {
        showToast('Có lỗi kết nối máy chủ', 'error');
      }
    }

    // 9. Quick View Category Products Logic
    let currentCategoryProducts = [];

    async function openCategoryProductsModal(catId, catName, catSlug, itemCount) {
      const modal = document.getElementById('categoryProductsModal');
      const titleName = document.getElementById('quickViewCatName');
      const badge = document.getElementById('quickViewCatBadge');
      const fullPageLink = document.getElementById('quickViewFullPageLink');
      const addBtn = document.getElementById('quickViewAddProductBtn');
      const emptyAddBtn = document.getElementById('emptyAddBtn');
      const searchInput = document.getElementById('quickViewSearchInput');
      const tableBody = document.getElementById('quickViewTableBody');
      const loading = document.getElementById('quickViewLoading');
      const empty = document.getElementById('quickViewEmpty');
      const table = document.getElementById('quickViewTable');
      const summaryText = document.getElementById('quickViewSummaryCount');

      if (!modal) return;

      if (searchInput) searchInput.value = '';
      if (titleName) titleName.textContent = catName;
      if (badge) badge.textContent = `${itemCount} Mẫu`;
      if (summaryText) summaryText.textContent = `Đang tải sản phẩm...`;
      if (fullPageLink) fullPageLink.href = `/admin/products?category=${catSlug}`;
      if (addBtn) addBtn.href = `/admin/products/new?category=${catSlug}`;
      if (emptyAddBtn) emptyAddBtn.href = `/admin/products/new?category=${catSlug}`;

      modal.style.display = 'flex';
      if (loading) loading.style.display = 'block';
      if (table) table.style.display = 'none';
      if (empty) empty.style.display = 'none';
      if (tableBody) tableBody.innerHTML = '';

      if (window.lucide) window.lucide.createIcons();

      try {
        const res = await fetch(`/api/categories/${catId}/products`);
        const data = await res.json();

        if (loading) loading.style.display = 'none';

        if (data.success && Array.isArray(data.data)) {
          currentCategoryProducts = data.data;
          renderQuickViewProducts(currentCategoryProducts);
        } else {
          currentCategoryProducts = [];
          if (empty) empty.style.display = 'block';
          if (summaryText) summaryText.textContent = `0 sản phẩm`;
        }
      } catch (err) {
        if (loading) loading.style.display = 'none';
        showToast('Lỗi khi tải danh sách sản phẩm', 'error');
        if (empty) empty.style.display = 'block';
      }
    }

    function closeCategoryProductsModal() {
      const modal = document.getElementById('categoryProductsModal');
      if (modal) modal.style.display = 'none';
    }

    function renderQuickViewProducts(products) {
      const table = document.getElementById('quickViewTable');
      const tableBody = document.getElementById('quickViewTableBody');
      const empty = document.getElementById('quickViewEmpty');
      const summaryText = document.getElementById('quickViewSummaryCount');
      const badge = document.getElementById('quickViewCatBadge');

      if (badge) badge.textContent = `${products.length} Mẫu`;
      if (summaryText) summaryText.textContent = `Đang hiển thị ${products.length} sản phẩm`;

      if (!products || products.length === 0) {
        if (table) table.style.display = 'none';
        if (empty) empty.style.display = 'block';
        return;
      }

      if (table) table.style.display = 'table';
      if (empty) empty.style.display = 'none';

      const nf = new Intl.NumberFormat('vi-VN');

      tableBody.innerHTML = products.map(p => {
        const img = (p.images && p.images[0]) ? p.images[0] : 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=400&q=80';
        
        let priceStr = nf.format(p.price) + 'đ';
        if (p.hasVariants && p.variants && p.variants.length > 1) {
          const prices = p.variants.map(v => v.price).filter(Boolean);
          if (prices.length > 0) {
            const minP = Math.min(...prices);
            const maxP = Math.max(...prices);
            priceStr = (minP !== maxP) ? `${nf.format(minP)}đ - ${nf.format(maxP)}đ` : `${nf.format(minP)}đ`;
          }
        }

        let variantsBadge = '';
        if (p.hasVariants && p.variants && p.variants.length) {
          variantsBadge = `<span style="font-size: 0.65rem; font-weight: 700; color: #1D4ED8; background: #EFF6FF; border: 1px solid #BFDBFE; padding: 1px 6px; border-radius: 4px; display: inline-flex; align-items: center; gap: 3px; margin-top: 3px;"><i data-lucide="layers" style="width: 10px; height: 10px;"></i>${p.variants.length} màu</span>`;
        }

        let stockBadge = '';
        const stockNum = Number(p.stock) || 0;
        if (stockNum <= 0) {
          stockBadge = `<span style="background: #FEE2E2; color: #991B1B; font-weight: 700; font-size: 0.72rem; padding: 3px 8px; border-radius: 10px; display: inline-flex; align-items: center; gap: 4px;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #EF4444;"></span>Hết hàng (0)</span>`;
        } else if (stockNum <= 10) {
          stockBadge = `<span style="background: #FEF3C7; color: #92400E; font-weight: 700; font-size: 0.72rem; padding: 3px 8px; border-radius: 10px; display: inline-flex; align-items: center; gap: 4px;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #F59E0B;"></span>Sắp hết (${stockNum})</span>`;
        } else {
          stockBadge = `<span style="background: #ECFDF5; color: #065F46; font-weight: 700; font-size: 0.72rem; padding: 3px 8px; border-radius: 10px; display: inline-flex; align-items: center; gap: 4px;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #10B981;"></span>Còn hàng (${stockNum})</span>`;
        }

        const isHidden = !!p.isHidden;
        const statusBadge = isHidden ?
          `<span style="background: #FFFBEB; color: #B45309; border: 1px solid #FCD34D; font-weight: 700; font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;"><i data-lucide="eye-off" style="width: 11px; height: 11px;"></i>Đã Ẩn</span>` :
          `<span style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-weight: 700; font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;"><i data-lucide="eye" style="width: 11px; height: 11px;"></i>Mở Bán</span>`;

        let tags = '';
        if (p.isSale) tags += `<span style="background: #FEE2E2; color: #DC2626; font-size: 0.65rem; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-right: 4px;">Sale</span>`;
        if (p.isFeatured) tags += `<span style="background: #FEF3C7; color: #B45309; font-size: 0.65rem; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-right: 4px;">Hot</span>`;

        return `
          <tr style="border-bottom: 1px solid #F1F5F9; transition: background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background='transparent'">
            <td style="padding: 10px 16px; text-align: center; vertical-align: middle;">
              <img src="${img}" alt="${p.name}" style="width: 42px; height: 42px; object-fit: cover; border-radius: 6px; border: 1px solid #E2E8F0; background: #F8FAFC;">
            </td>
            <td style="padding: 10px 16px; vertical-align: middle;">
              <div style="font-weight: 700; color: #1E293B; line-height: 1.3; margin-bottom: 3px;">
                ${p.name}
              </div>
              <div style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: #64748B;">
                <span style="font-family: monospace; background: #F1F5F9; padding: 1px 5px; border-radius: 3px;">SKU: ${p.id}</span>
                ${tags}
              </div>
            </td>
            <td style="padding: 10px 16px; vertical-align: middle;">
              <div style="font-weight: 800; color: #0F172A;">${priceStr}</div>
              ${variantsBadge}
            </td>
            <td style="padding: 10px 16px; text-align: center; vertical-align: middle;">
              ${stockBadge}
            </td>
            <td style="padding: 10px 16px; text-align: center; vertical-align: middle;">
              ${statusBadge}
            </td>
            <td style="padding: 10px 16px; text-align: right; vertical-align: middle;">
              <div style="display: inline-flex; align-items: center; gap: 6px;">
                <a href="/admin/products/edit/${p.id}" target="_blank" title="Chỉnh sửa sản phẩm" style="padding: 5px 9px; font-size: 0.75rem; font-weight: 700; color: #1D4ED8; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 3px;">
                  <i data-lucide="edit-3" style="width: 12px; height: 12px;"></i> Sửa
                </a>
                <a href="/product/${p.slug}" target="_blank" title="Xem trên web khách hàng" style="padding: 5px 9px; font-size: 0.75rem; font-weight: 700; color: #475569; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 3px;">
                  <i data-lucide="globe" style="width: 12px; height: 12px;"></i> Web
                </a>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      if (window.lucide) window.lucide.createIcons();
    }

    function filterQuickViewProducts(query) {
      if (!query || !query.trim()) {
        renderQuickViewProducts(currentCategoryProducts);
        return;
      }
      const rawQ = query.trim().toLowerCase();
      const normQ = removeVietnameseTones(rawQ);
      const filtered = currentCategoryProducts.filter(p => {
        const name = (p.name || '').toLowerCase();
        const normName = removeVietnameseTones(name);
        const id = (p.id || '').toLowerCase();
        const slug = (p.slug || '').toLowerCase();
        return name.includes(rawQ) || normName.includes(normQ) || id.includes(rawQ) || slug.includes(rawQ);
      });
      renderQuickViewProducts(filtered);
    }

    // Global Keydown & Click Outside Listeners
    window.addEventListener('click', (e) => {
      const modalCreate = document.getElementById('createCategoryModal');
      const modalEdit = document.getElementById('editCategoryModal');
      const modalProducts = document.getElementById('categoryProductsModal');
      if (e.target === modalCreate) closeCreateCategoryModal();
      if (e.target === modalEdit) closeEditCategoryModal();
      if (e.target === modalProducts) closeCategoryProductsModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeCreateCategoryModal();
        closeEditCategoryModal();
        closeCategoryProductsModal();
      }
    });

    // Run lucide icons on load
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();
    });
