extends ../../layouts/main

block content
  .admin-layout
    //- Admin Sidebar
    include ../../partials/admin-sidebar

    //- Main Content (Full Width, No Empty Side Gaps)
    main.admin-content(style="padding-bottom: 80px;")
      
      //- Standard Admin Header & Breadcrumbs Trail (Full Width)
      .admin-page-header(style="margin-bottom: 24px;")
        div
          .breadcrumb-trail
            span Atelier System
            span.breadcrumb-separator /
            a(href="/admin/products", style="color: inherit; text-decoration: none;") Quản lý sản phẩm
            span.breadcrumb-separator /
            span.current= isEdit ? 'Chỉnh sửa sản phẩm' : 'Thêm mới sản phẩm'
          h1(style="font-size: 1.625rem; font-weight: 800; color: var(--text-main); margin: 0; letter-spacing: -0.02em;")
            = isEdit ? `Chỉnh Sửa Sản Phẩm: ${product.name}` : 'Thêm Mới Sản Phẩm Vào Cửa Hàng'
          p(style="color: var(--text-muted); font-size: 0.8125rem; margin: 4px 0 0;")
            = isEdit ? `Cập nhật thông tin, giá bán, tồn kho và hình ảnh sản phẩm (Mã SKU: ${product.id})` : 'Điền thông tin theo các mục bên dưới để mở bán sản phẩm mới trên website Atelier.'

        .header-actions-group
          if isEdit && product
            a.btn.btn-sm.btn-secondary(href=`/product/${product.slug}`, target="_blank", style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; font-size: 0.8125rem; font-weight: 600;")
              i(data-lucide="external-link", style="width: 14px; height: 14px;")
              | Xem Trên Web

          a.btn.btn-sm.btn-secondary(href="/admin/products", style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; font-size: 0.8125rem; font-weight: 600;")
            i(data-lucide="arrow-left", style="width: 14px; height: 14px;")
            | Quay Lại Danh Sách

          button.btn.btn-sm(
            type="button",
            onclick="submitProductForm()",
            style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 20px; font-size: 0.8125rem; font-weight: 700; background: #0F172A; color: #FFFFFF; border-radius: var(--radius-sm); box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15); transition: background 0.2s;"
          )
            i(data-lucide="save", style="width: 14px; height: 14px; color: var(--accent-gold);")
            span.saveBtnText= isEdit ? 'Lưu Thay Đổi' : 'Tạo Sản Phẩm'

      //- 2-Column Responsive SaaS Form Layout (Fills 100% Width, Zero Wasted Space)
      form#product-form(
        onsubmit="event.preventDefault(); submitProductForm();",
        style="display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: flex-start; width: 100%;"
      )
        input#productId(type="hidden", value=(product ? product.id : ''))
        input#isHiddenVal(type="hidden", value=(product && product.isHidden ? 'true' : 'false'))

        //- =========================================================================
        //- CỘT TRÁI (MAIN FORM - 70%): NỘI DUNG CHÍNH CỦA SẢN PHẨM
        //- =========================================================================
        .product-form-left(style="display: flex; flex-direction: column; gap: 22px; width: 100%; min-width: 0;")
          
          //- Card 1: Thông tin cơ bản & Mô tả
          .admin-card(style="padding: 24px; border: 1px solid var(--border-subtle); margin: 0; background: #FFFFFF; border-radius: var(--radius-md); box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);")
            .card-title-row(style="display: flex; align-items: center; gap: 8px; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid #F1F5F9;")
              i(data-lucide="file-text", style="width: 18px; height: 18px; color: var(--accent-gold);")
              h2(style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;") 1. Thông Tin Cơ Bản &amp; Mô Tả

            .form-group(style="margin-bottom: 18px;")
              label.form-label(for="name", style="font-weight: 700; font-size: 0.84rem; color: #1E293B; margin-bottom: 6px; display: block;")
                | Tên sản phẩm * 
                span(style="color: #EF4444; font-weight: 800;") (Bắt buộc)
              input#name.form-control(
                type="text",
                name="name",
                value=(product ? product.name : ''),
                placeholder="Ví dụ: Thắt Lưng Da Bò Ý Khóa Tự Động Black Onyx",
                required,
                style="width: 100%; height: 44px; font-size: 0.95rem; font-weight: 700; padding: 0 14px; border: 1.5px solid #CBD5E1; border-radius: 6px;"
              )
              div(style="font-size: 0.72rem; color: #64748B; margin-top: 5px;")
                | Đặt tên ngắn gọn, rõ ràng kèm chất liệu hoặc màu sắc để khách dễ nhận biết và tìm kiếm.

            .form-group(style="margin-bottom: 18px;")
              label.form-label(for="description", style="font-weight: 700; font-size: 0.84rem; color: #1E293B; margin-bottom: 6px; display: block;")
                | Mô tả chi tiết sản phẩm * 
                span(style="color: #EF4444; font-weight: 800;") (Bắt buộc)
              textarea#description.form-control(
                name="description",
                rows="5",
                placeholder="Mô tả kỹ về nguồn gốc chất liệu, độ bền, phong cách phối đồ, đối tượng sử dụng và hướng dẫn bảo quản...",
                required,
                style="width: 100%; padding: 12px 14px; font-size: 0.875rem; line-height: 1.6; border: 1.5px solid #CBD5E1; border-radius: 6px;"
              )= product ? product.description : ''
              div(style="font-size: 0.72rem; color: #64748B; margin-top: 5px;")
                | Nội dung này sẽ hiển thị ở phần giới thiệu chi tiết sản phẩm khi khách hàng bấm vào xem.

            //- 3 Điểm nổi bật tóm tắt
            .form-group(style="margin-bottom: 0;")
              label.form-label(style="font-weight: 700; font-size: 0.84rem; color: #1E293B; margin-bottom: 4px; display: block;")
                | 3 Đặc điểm nổi bật tóm tắt:
              p(style="font-size: 0.72rem; color: #64748B; margin: 0 0 10px 0;")
                | 3 dòng ngắn gọn này sẽ hiển thị ngay dưới giá ở trang bán hàng, giúp khách nắm bắt nhanh ưu điểm để chốt đơn nhanh hơn.
              
              .highlights-list(style="display: flex; flex-direction: column; gap: 8px;")
                .hl-row(style="display: flex; align-items: center; gap: 8px;")
                  span(style="font-size: 0.78rem; font-weight: 700; color: #0F172A; width: 68px; flex-shrink: 0;") Gạch đầu 1:
                  input#hl1.form-control(
                    type="text",
                    placeholder="Ví dụ: Da bò thật 100% nguyên tấm, không bong tróc",
                    value=(product && product.highlights && product.highlights[0] ? product.highlights[0] : (isEdit ? '' : 'Da bò thật 100% nguyên tấm')),
                    style="flex: 1; height: 38px; font-size: 0.84rem; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 6px;"
                  )
                .hl-row(style="display: flex; align-items: center; gap: 8px;")
                  span(style="font-size: 0.78rem; font-weight: 700; color: #0F172A; width: 68px; flex-shrink: 0;") Gạch đầu 2:
                  input#hl2.form-control(
                    type="text",
                    placeholder="Ví dụ: Khóa tự động hợp kim chống oxy hóa cao cấp",
                    value=(product && product.highlights && product.highlights[1] ? product.highlights[1] : (isEdit ? '' : 'Khóa tự động không cần bấm lỗ')),
                    style="flex: 1; height: 38px; font-size: 0.84rem; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 6px;"
                  )
                .hl-row(style="display: flex; align-items: center; gap: 8px;")
                  span(style="font-size: 0.78rem; font-weight: 700; color: #0F172A; width: 68px; flex-shrink: 0;") Gạch đầu 3:
                  input#hl3.form-control(
                    type="text",
                    placeholder="Ví dụ: Bảo hành chính hãng 24 tháng, đổi trả 7 ngày",
                    value=(product && product.highlights && product.highlights[2] ? product.highlights[2] : (isEdit ? '' : 'Bảo hành chính hãng 24 tháng')),
                    style="flex: 1; height: 38px; font-size: 0.84rem; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 6px;"
                  )

          //- Card 2: Hình ảnh sản phẩm (Trực quan, dễ dùng)
          //- Card 2: Hình ảnh sản phẩm (Bộ sưu tập ảnh đa góc chụp & ảnh phụ không giới hạn)
          .admin-card(style="padding: 24px; border: 1px solid var(--border-subtle); margin: 0; background: #FFFFFF; border-radius: var(--radius-md); box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);")
            .card-title-row(style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #F1F5F9; flex-wrap: wrap; gap: 8px;")
              div(style="display: flex; align-items: center; gap: 8px;")
                i(data-lucide="images", style="width: 18px; height: 18px; color: #2563EB;")
                h2(style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;") 2. Hình Ảnh Sản Phẩm &amp; Bộ Sưu Tập Ảnh Phụ
              span#galleryCountText(style="font-size: 0.78rem; font-weight: 700; color: #2563EB; background: #EFF6FF; padding: 4px 10px; border-radius: 6px;") Đang có 0 hình ảnh

            p(style="font-size: 0.78rem; color: #64748B; margin: 0 0 16px 0; line-height: 1.45;")
              | Bạn có thể tải lên 
              strong 3, 4, 5, 6 hoặc nhiều ảnh phụ tùy thích 
              | (các góc chụp, hộp đựng, cận cảnh chất da, tem mác...). Hệ thống hỗ trợ 
              strong chọn nhiều ảnh cùng lúc 
              | từ máy tính. Ảnh có ngôi sao vàng đầu tiên là 
              strong Ảnh đại diện chính
              | .

            //- Helper Banner: Liên kết ảnh phụ với màu sắc & giá riêng
            .gallery-link-helper(style="background: #F0FDF4; border: 1.5px solid #BBF7D0; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px; display: flex; align-items: flex-start; gap: 10px;")
              i(data-lucide="sparkles", style="width: 18px; height: 18px; color: #16A34A; flex-shrink: 0; margin-top: 1px;")
              div(style="font-size: 0.8125rem; color: #166534; line-height: 1.45;")
                strong(style="color: #15803D;") Hướng dẫn tạo Màu Sắc &amp; Giá Riêng từ Ảnh Phụ:
                div(style="margin-top: 3px; color: #14532D;")
                  | Khi bạn tải các ảnh phụ lên (ví dụ: thắt lưng màu Đen, màu Nâu, màu Xanh...), bạn chỉ cần bấm nút 
                  strong(style="color: #1D4ED8; background: #DBEAFE; padding: 1px 6px; border-radius: 4px; font-size: 0.75rem;") + Đặt giá riêng
                  |  ngay dưới mỗi ảnh. Hệ thống sẽ tự động kích hoạt 
                  strong Mục 3 
                  | và gắn sẵn ảnh đó để bạn nhập tên màu và giá bán riêng mà không cần tải lại ảnh!

            //- Dynamic Gallery Grid Container
            #galleryGrid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 14px; margin-bottom: 16px;")
              //- Rendered dynamically by JS

            //- Action buttons & hidden multi-file input
            input#multiFileInput(type="file", accept="image/*", multiple, style="display: none;", onchange="handleMultiFilesUpload(this)")
            
            div(style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;")
              button.btn.btn-sm(
                type="button",
                onclick="document.getElementById('multiFileInput').click()",
                style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 0.8125rem; font-weight: 700; background: #0F172A; color: #FFFFFF; border-radius: 6px; cursor: pointer;"
              )
                i(data-lucide="upload-cloud", style="width: 15px; height: 15px; color: var(--accent-gold);")
                | + Tải Thêm Ảnh Từ Máy Tính (Chọn 1 hoặc nhiều ảnh)

              button.btn.btn-sm(
                type="button",
                onclick="promptGalleryImageUrl()",
                style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; font-size: 0.8125rem; font-weight: 600; background: #FFFFFF; border: 1.5px solid #CBD5E1; color: #475569; border-radius: 6px; cursor: pointer;"
              )
                i(data-lucide="link", style="width: 14px; height: 14px;")
                | 🔗 Dán Link Ảnh Online

          //- Card 3: Giá bán & Quản lý tồn kho
          .admin-card(style="padding: 24px; border: 1px solid var(--border-subtle); margin: 0; background: #FFFFFF; border-radius: var(--radius-md); box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);")
            .card-title-row(style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid #F1F5F9; flex-wrap: wrap; gap: 10px;")
              div(style="display: flex; align-items: center; gap: 8px;")
                i(data-lucide="tag", style="width: 18px; height: 18px; color: #059669;")
                h2(style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;") 3. Giá Bán &amp; Quản Lý Tồn Kho

            //- Switch: Tùy biến biến thể / Màu sắc có giá riêng
            .variant-toggle-box(style="background: #F8FAFC; border: 1.5px solid #E2E8F0; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px;")
              label(style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; margin: 0;")
                input#hasVariantsToggle(
                  type="checkbox",
                  checked=(product && product.hasVariants),
                  onchange="toggleVariantSection(this.checked)",
                  style="width: 20px; height: 20px; accent-color: #2563EB; margin-top: 2px; cursor: pointer;"
                )
                div
                  strong(style="font-size: 0.875rem; color: #0F172A; display: flex; align-items: center; gap: 6px;")
                    i(data-lucide="layers", style="width: 16px; height: 16px; color: #2563EB;")
                    | Sản phẩm có nhiều Màu Sắc / Phiên Bản với GIÁ và TỒN KHO RIÊNG BIỆT
                  p(style="font-size: 0.75rem; color: #64748B; margin: 4px 0 0; line-height: 1.45;")
                    | Bật tính năng này nếu mỗi màu sắc có giá bán hoặc giá nhập khác nhau (Ví dụ: Thắt lưng Đen giá 100.000đ, Thắt lưng Xanh giá 120.000đ). Khi khách chọn màu trên website, giá và tồn kho sẽ tự động thay đổi chính xác.

            //- KHỐI 1: GIÁ BÁN ĐƠN LẺ TIÊU CHUẨN (Hiển thị khi KHÔNG bật biến thể)
            #singlePricingSection(style=(product && product.hasVariants ? "display: none;" : "display: block;"))
              .pricing-inputs-grid(style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;")
                
                //- 1. Giá bán thực tế
                .price-col
                  label(for="price", style="display: block; font-size: 0.84rem; font-weight: 700; color: #047857; margin-bottom: 6px;")
                    | Giá bán thực tế (VNĐ) * 
                    span(style="color: #EF4444;") *
                  .money-input-wrap(style="position: relative;")
                    input#price.form-control(
                      type="number",
                      name="price",
                      min="0",
                      step="1000",
                      value=(product ? product.price : ''),
                      placeholder="VD: 350000",
                      style="width: 100%; height: 44px; font-size: 1rem; font-weight: 800; color: #047857; padding-left: 12px; padding-right: 42px; border: 2px solid #10B981; border-radius: 6px;",
                      oninput="updatePricingHelper()"
                    )
                    span(style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-weight: 800; color: #047857; font-size: 0.8125rem; pointer-events: none;") đ
                  #livePriceWords(style="font-size: 0.72rem; color: #047857; font-weight: 700; margin-top: 5px;")
                    | (Giá khách trả khi đặt hàng)

                //- 2. Giá gốc niêm yết
                .price-col
                  label(for="originalPrice", style="display: block; font-size: 0.84rem; font-weight: 700; color: #475569; margin-bottom: 6px;")
                    | Giá gốc niêm yết (VNĐ)
                  .money-input-wrap(style="position: relative;")
                    input#originalPrice.form-control(
                      type="number",
                      name="originalPrice",
                      min="0",
                      step="1000",
                      value=(product && product.originalPrice && product.originalPrice > product.price ? product.originalPrice : (product ? product.price : '')),
                      placeholder="VD: 450000",
                      style="width: 100%; height: 44px; font-size: 0.92rem; font-weight: 600; color: #475569; padding-left: 12px; padding-right: 42px; border: 1.5px solid #CBD5E1; border-radius: 6px;",
                      oninput="updatePricingHelper()"
                    )
                    span(style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-weight: 700; color: #94A3B8; font-size: 0.8125rem; pointer-events: none;") đ
                  #liveDiscountStatus(style="font-size: 0.72rem; color: #64748B; margin-top: 5px;")
                    | (Để trống nếu không giảm giá)

                //- 3. Tồn kho
                .price-col
                  label(for="stock", style="display: block; font-size: 0.84rem; font-weight: 700; color: #1E293B; margin-bottom: 6px;")
                    | Số lượng trong kho * 
                    span(style="color: #EF4444;") *
                  .money-input-wrap(style="position: relative;")
                    input#stock.form-control(
                      type="number",
                      name="stock",
                      min="0",
                      value=(product ? product.stock : (isEdit ? 0 : 50)),
                      placeholder="VD: 50",
                      style="width: 100%; height: 44px; font-size: 1rem; font-weight: 800; color: #0F172A; padding-left: 12px; padding-right: 52px; border: 1.5px solid #CBD5E1; border-radius: 6px;"
                    )
                    span(style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-weight: 700; color: #64748B; font-size: 0.8125rem; pointer-events: none;") Chiếc
                  div(style="font-size: 0.72rem; color: #64748B; margin-top: 5px;")
                    | Tự động trừ khi có khách mua

              #pricingAlertBox(style="display: none; padding: 10px 14px; background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 6px; font-size: 0.78rem; color: #065F46; align-items: center; gap: 8px;")
                i(data-lucide="tag", style="width: 15px; height: 15px; color: #059669; flex-shrink: 0;")
                span#pricingAlertText Khách hàng sẽ thấy giá gạch ngang giảm giá.

            //- KHỐI 2: BẢNG BIẾN THỂ MÀU SẮC & GIÁ RIÊNG (Hiển thị khi BẬT biến thể)
            #variantPricingSection(style=(product && product.hasVariants ? "display: block;" : "display: none;"))
              .variant-instructions(style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; padding: 10px 14px; margin-bottom: 12px; font-size: 0.78rem; color: #1E40AF; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;")
                div(style="display: flex; align-items: center; gap: 8px;")
                  i(data-lucide="info", style="width: 16px; height: 16px; color: #2563EB; flex-shrink: 0;")
                  span Mỗi dòng tương ứng với 1 màu sắc. Bấm vào ô <strong>"Ảnh Riêng Màu"</strong> để chọn nhanh ảnh đã tải ở Mục 2 hoặc tải ảnh mới từ máy tính.
                span(style="font-size: 0.75rem; color: #2563EB; font-weight: 700; background: #DBEAFE; padding: 2px 8px; border-radius: 4px;") Khách chọn màu nào → Hiện đúng giá &amp; ảnh đó

              .variant-table-wrap(style="background: #FFFFFF; border: 1.5px solid #CBD5E1; border-radius: 8px; overflow: hidden; margin-bottom: 14px; box-shadow: 0 1px 2px rgba(0,0,0,0.03);")
                table#variantsTable(style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8125rem;")
                  thead(style="background: #0F172A; color: #FFFFFF;")
                    tr
                      th(style="padding: 10px 14px; font-weight: 700; width: 23%;") Tên Màu Sắc / Phiên Bản *
                      th(style="padding: 10px 8px; font-weight: 700; width: 11%; text-align: center;") Mã Màu
                      th(style="padding: 10px 8px; font-weight: 700; width: 14%; text-align: center;") Ảnh Riêng Màu
                      th(style="padding: 10px 12px; font-weight: 700; width: 19%;") Giá Bán (VNĐ) *
                      th(style="padding: 10px 12px; font-weight: 700; width: 16%;") Giá Gốc (VNĐ)
                      th(style="padding: 10px 10px; font-weight: 700; width: 11%; text-align: center;") Tồn Kho *
                      th(style="padding: 10px 6px; font-weight: 700; width: 6%; text-align: center;") Xóa
                  tbody#variantsTableBody
                    //- JS render rows here
                
                .variant-table-empty#variantEmptyMsg(style="display: none; padding: 24px; text-align: center; color: #64748B; font-size: 0.84rem;")
                  i(data-lucide="info", style="width: 24px; height: 24px; color: #94A3B8; margin-bottom: 6px; display: inline-block;")
                  div Chưa có màu sắc nào. Vui lòng bấm nút "+ Thêm Màu Sắc / Phiên Bản Mới" hoặc chọn từ ảnh Mục 2 bên dưới.

              //- Actions & Real-time Variant Summary
              div(style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 6px;")
                div(style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;")
                  button.btn.btn-sm(
                    type="button",
                    onclick="addVariantRow()",
