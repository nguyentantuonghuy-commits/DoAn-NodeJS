extends ../layouts/main

block content
  // Breadcrumb
  .container(style="padding-top: 30px;")
    .breadcrumb
      a(href="/") Trang Chủ
      span.sep /
      a(href="/blog") Tạp Chí
      span.sep /
      span= blog.category

  // Article Main Container
  article.article-page-section
    .container
      .article-layout-grid
        // Main Editorial Content
        .article-main-content
          header.article-header
            span.article-badge= blog.category
            h1.article-title= blog.title
            
            .article-author-strip
              .author-meta-block
                img.author-avatar(src=blog.authorAvatar, alt=blog.author)
                .author-text
                  strong= blog.author
                  span Biên tập viên thời trang Atelier
              
              .article-stats
                span
                  i(data-lucide="calendar", style="width: 14px; height: 14px;")
                  = new Date(blog.createdAt).toLocaleDateString('vi-VN')
                span
                  i(data-lucide="clock", style="width: 14px; height: 14px;")
                  = blog.readTime
                span
                  i(data-lucide="eye", style="width: 14px; height: 14px;")
                  = `${blog.views} lượt xem`

          // Hero Cover Image
          .article-cover-wrap
            img(src=blog.coverImage, alt=blog.title)

          // Lead intro
          p.article-lead= blog.summary

          // Main HTML Content
          .article-body-text
            != blog.content

          // Share and Tags Bar
          .article-share-strip
            .share-label
              i(data-lucide="share-2", style="width: 16px; height: 16px;")
              | Chia sẻ bài viết:
            .share-buttons
              button.share-btn(onclick="navigator.clipboard.writeText(window.location.href); showToast('Đã sao chép link bài viết!', 'success');")
                i(data-lucide="link", style="width: 15px; height: 15px;")
                | Sao chép link
              a.share-btn(href="#", onclick="showToast('Đang mở chia sẻ Facebook...', 'info'); return false;") Facebook
              a.share-btn(href="#", onclick="showToast('Đang mở chia sẻ Zalo...', 'info'); return false;") Zalo

          // Related Blogs
          if relatedBlogs && relatedBlogs.length
            .related-articles-section
              h3.related-title Bài Viết Cùng Chủ Đề
              .related-grid
                each rel in relatedBlogs
                  a.related-card(href=`/blog/${rel.slug}`)
                    img(src=rel.coverImage, alt=rel.title)
                    .related-info
                      span.rel-cat= rel.category
                      h4= rel.title
                      span.rel-date= new Date(rel.createdAt).toLocaleDateString('vi-VN')

        // Sidebar
        aside.article-sidebar
          // Featured Products Mentioned
          if featuredProducts && featuredProducts.length
            .sidebar-widget
              h3.widget-title Phụ Kiện Gợi Ý
              .widget-products
                each prod in featuredProducts
                  a.widget-product-item(href=`/product/${prod.slug}`)
                    img(src=prod.images[0], alt=prod.name)
                    .widget-product-info
                      h4= prod.name
                      .widget-price= `${prod.price.toLocaleString('vi-VN')}đ`
                      span.view-btn Mua ngay &rarr;

          // VIP Newsletter Widget
          .sidebar-widget.newsletter-widget
            i(data-lucide="mail", style="width: 28px; height: 28px; color: var(--accent-gold); margin-bottom: 12px;")
            h3 Gia Nhập VIP Club
            p Nhận voucher 100K và những bài viết phối đồ mới nhất mỗi tuần.
            form(onsubmit="event.preventDefault(); showToast('Đã đăng ký thành công!', 'success');")
              input(type="email", placeholder="Email của bạn...", required)
              button.btn.btn-primary.btn-block(type="submit", style="margin-top: 10px;") Đăng Ký
