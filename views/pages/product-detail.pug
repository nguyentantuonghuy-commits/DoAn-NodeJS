extends ../layouts/main

block content
  .container(style="padding-top: 24px;")
    //- Breadcrumbs
    nav(aria-label="Breadcrumb", style="margin-bottom: 24px; font-size: 0.8125rem; color: var(--text-muted);")
      a(href="/") Trang Chủ
      span(style="margin: 0 8px;") /
      a(href="/shop") Cửa Hàng
      span(style="margin: 0 8px;") /
      if category
        a(href=`/shop?category=${category.slug}`)= category.name
        span(style="margin: 0 8px;") /
      span(style="color: var(--text-main); font-weight: 600;")= product.name

    //- 1. PRODUCT DETAIL MAIN LAYOUT (Gallery + Buy Box)
    .product-detail-layout
      //- Left: Gallery Component
      .gallery-wrapper
        if product.images && product.images.length > 1
          .gallery-thumbs
            each img, idx in product.images
              img.gallery-thumb(
                src=img,
                alt=product.name,
                class=(idx === 0 ? 'active' : ''),
                data-large=img
              )
        .gallery-main
          img#main-product-img(src=product.images[0], alt=product.name)

      //- Right: Buy Box & Product Info
      .product-info-panel
        if product.categoryName
          span.sub-title(style="color: var(--accent-gold); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;")
            = product.categoryName

        h1= product.name

        //- Meta: Rating & Sold Count
        .product-meta
          .rating-stars(style="display: flex; align-items: center; gap: 4px; color: #F59E0B; font-weight: 700;")
            i(data-lucide="star", style="width: 16px; height: 16px; fill: #F59E0B; stroke: none;")
            span= product.rating
            span(style="color: var(--text-muted); font-weight: 400;")= `(${product.reviewsCount} đánh giá)`
          span •
          span= `Đã bán: ${product.soldCount}`
          span •
          span(style="color: var(--accent-emerald); font-weight: 600;") Còn hàng trong kho

        //- Price Box
        .product-detail-price(style="margin-bottom: 20px;")
          span.detail-price-main#detail-price-main(style="font-size: 1.875rem; font-weight: 800; color: #DC2626;")
            = new Intl.NumberFormat('vi-VN').format(product.hasVariants && product.variants && product.variants.length ? product.variants[0].price : product.price) + 'đ'
          
          - const firstOrig = (product.hasVariants && product.variants && product.variants.length ? product.variants[0].originalPrice : product.originalPrice)
          - const firstPrice = (product.hasVariants && product.variants && product.variants.length ? product.variants[0].price : product.price)
          
          span.detail-price-old#detail-price-old(style=(firstOrig > firstPrice ? "font-size: 1.1rem; color: #94A3B8; text-decoration: line-through; margin-left: 10px;" : "display: none; font-size: 1.1rem; color: #94A3B8; text-decoration: line-through; margin-left: 10px;"))
            = new Intl.NumberFormat('vi-VN').format(firstOrig) + 'đ'
          
          span.badge.badge-sale#detail-discount-badge(style=(firstOrig > firstPrice ? "margin-left: 10px; background: #FEE2E2; color: #DC2626; font-weight: 800; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem;" : "display: none; margin-left: 10px; background: #FEE2E2; color: #DC2626; font-weight: 800; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem;"))
            = `Tiết kiệm ${Math.round(((firstOrig - firstPrice) / firstOrig) * 100)}%`

        //- Variant / Color Picker
        if product.hasVariants && product.variants && product.variants.length
          .variant-picker(style="margin-bottom: 24px; padding: 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;")
            .variant-title(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;")
              div(style="font-size: 0.875rem; font-weight: 700; color: #1E293B;")
                | Chọn Màu Sắc / Biến Thể: 
                span#selected-color-label(style="color: #2563EB; font-weight: 800;")= product.variants[0].name
              span#variant-stock-status(style="font-size: 0.8125rem; font-weight: 700; color: #059669;")
                = `Còn ${product.variants[0].stock} chiếc`
            
            .variant-swatches(style="display: flex; gap: 10px; flex-wrap: wrap;")
              each v, idx in product.variants
                button.variant-btn(
                  type="button",
                  class=(idx === 0 ? 'active' : ''),
                  data-name=v.name,
                  data-price=v.price,
                  data-original-price=(v.originalPrice || v.price),
                  data-stock=v.stock,
                  data-image=(v.image || product.images[0]),
                  onclick="selectProductVariant(this)",
                  onmouseenter="previewProductVariant(this)",
                  onmouseleave="restoreProductVariant()",
                  style=(idx === 0 ? "cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px; border: 2px solid #0F172A; background: #FFFFFF; box-shadow: 0 2px 6px rgba(0,0,0,0.06); transition: all 0.2s;" : "cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid #CBD5E1; background: #FFFFFF; transition: all 0.2s;")
                )
                  if v.image
                    img(src=v.image, alt=v.name, style="width: 22px; height: 22px; border-radius: 4px; object-fit: cover; border: 1px solid rgba(0,0,0,0.12); flex-shrink: 0;")
                  else if v.color
                    span(style=`display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: ${v.color}; border: 1px solid rgba(0,0,0,0.15); flex-shrink: 0;`)
                  strong= v.name
                  span(style="font-size: 0.8rem; color: #047857; font-weight: 700;")= `${new Intl.NumberFormat('vi-VN').format(v.price)}đ`
        else if product.colors && product.colors.length
          .variant-picker(style="margin-bottom: 24px; padding: 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;")
            .variant-title(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;")
              div(style="font-size: 0.875rem; font-weight: 700; color: #1E293B;")
                | Chọn Màu Sắc: 
                span#selected-color-label(style="color: #2563EB; font-weight: 800;")= product.colors[0].name
              span#variant-stock-status(style="font-size: 0.8125rem; font-weight: 700; color: #059669;")
                = `Còn ${product.stock} chiếc`
            .variant-swatches(style="display: flex; gap: 10px; flex-wrap: wrap;")
              each col, idx in product.colors
                button.variant-btn(
                  type="button",
                  class=(idx === 0 ? 'active' : ''),
                  data-name=col.name,
                  data-price=product.price,
                  data-original-price=(product.originalPrice || product.price),
                  data-stock=product.stock,
                  data-image=(col.image || product.images[0]),
                  onclick="selectProductColor(this)",
                  style=(idx === 0 ? "cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px; border: 2px solid #0F172A; background: #FFFFFF; box-shadow: 0 2px 6px rgba(0,0,0,0.06); transition: all 0.2s;" : "cursor: pointer; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid #CBD5E1; background: #FFFFFF; transition: all 0.2s;")
                )
                  if col.image
                    img(src=col.image, alt=col.name, style="width: 22px; height: 22px; border-radius: 4px; object-fit: cover; border: 1px solid rgba(0,0,0,0.12); flex-shrink: 0;")
                  else if col.hex
                    span(style=`display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: ${col.hex}; border: 1px solid rgba(0,0,0,0.15); flex-shrink: 0;`)
                  strong= col.name
                  span(style="font-size: 0.8rem; color: #047857; font-weight: 700;")= `${new Intl.NumberFormat('vi-VN').format(product.price)}đ`

        //- Quantity Selector & Actions
        .quantity-row(style="margin-bottom: 20px;")
          span(style="font-size: 0.9375rem; font-weight: 700;") Số Lượng:
          .qty-spinner
            button.qty-btn.qty-minus(type="button") -
            input.qty-input(type="number", value="1", min="1", max=(product.hasVariants && product.variants && product.variants.length ? product.variants[0].stock : product.stock), readonly)
            button.qty-btn.qty-plus(type="button") +

        .buy-actions(style="display: flex; gap: 14px; margin-bottom: 30px;")
          button#detail-add-to-cart.btn.btn-lg.btn-secondary(
            type="button",
            style="flex: 1;",
            data-id=product.id,
            data-name=product.name,
            data-price=(product.hasVariants && product.variants && product.variants.length ? product.variants[0].price : product.price),
            data-image=(product.hasVariants && product.variants && product.variants.length && product.variants[0].image ? product.variants[0].image : (product.colors && product.colors[0] && product.colors[0].image ? product.colors[0].image : product.images[0])),
            data-color=(product.hasVariants && product.variants && product.variants.length ? product.variants[0].name : (product.colors && product.colors.length ? product.colors[0].name : 'Tiêu chuẩn'))
          )
            i(data-lucide="shopping-bag", style="width: 18px; height: 18px;")
            | Thêm Vào Giỏ Hàng

          button#buy-now-btn.btn.btn-lg.btn-primary(
            type="button",
            style="flex: 1.2;",
            onclick="handleBuyNow()"
          )
            i(data-lucide="zap", style="width: 18px; height: 18px; color: var(--accent-gold);")
            | Mua Ngay

        //- Coolmate-style Trust & Commitments Box
        .trust-box(style="background: var(--bg-secondary); border-radius: var(--radius-md); padding: 20px; border: 1px solid var(--border-subtle);")
          .trust-item(style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;")
            i(data-lucide="shield-check", style="width: 20px; height: 20px; color: var(--accent-emerald);")
            span(style="font-size: 0.875rem;") Cam kết 100% đúng mô tả &amp; da thật / titan 316L y tế.
          .trust-item(style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;")
            i(data-lucide="refresh-cw", style="width: 20px; height: 20px; color: var(--accent-blue);")
            span(style="font-size: 0.875rem;") Đổi trả miễn phí trong 30 ngày nếu không vừa ý.
          .trust-item(style="display: flex; align-items: center; gap: 12px;")
            i(data-lucide="gift", style="width: 20px; height: 20px; color: var(--accent-coral);")
            span(style="font-size: 0.875rem;") Tặng kèm hộp đựng cao cấp phù hợp làm quà tặng.

    //- 2. SPECIFICATIONS & DETAILED DESCRIPTION TABS
    section.section-padding(style="border-top: 1px solid var(--border-subtle); margin-top: 30px;")
      .section-header
        h2.section-title Thông Tin Chi Tiết &amp; Thông Số Kỹ Thuật

      .details-grid(style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px;")
        // Description
        .description-col
          h3(style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;") Mô Tả Sản Phẩm
          p(style="line-height: 1.8; color: #374151; margin-bottom: 20px;")= product.description

          if product.highlights && product.highlights.length
            h4(style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;") Điểm Nổi Bật Vượt Trội:
            ul(style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;")
              each hl in product.highlights
                li(style="display: flex; align-items: center; gap: 8px; font-size: 0.9375rem; color: #1F2937;")
                  i(data-lucide="check", style="width: 16px; height: 16px; color: var(--accent-emerald);")
                  span= hl

        // Specs Table
        .specs-col
          h3(style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;") Thông Số Kỹ Thuật
          table.specs-table
            tbody
              if product.specs
                tr
                  td Chất liệu
                  td= product.specs.material || 'Cao cấp'
                tr
                  td Kích thước
                  td= product.specs.dimensions || 'Tiêu chuẩn'
                tr
                  td Kiểu khóa
                  td= product.specs.lockType || 'Khóa hợp kim chống gỉ'
                tr
                  td Xuất xứ
                  td= product.specs.origin || 'Việt Nam'
                tr
                  td Chế độ bảo hành
                  td= product.specs.warranty || '12 tháng chính hãng'

    //- 3. CUSTOMER REVIEWS SECTION & SUBMISSION FORM
    section.section-padding(style="background: var(--bg-secondary); border-radius: var(--radius-lg); padding: 50px 40px; margin-bottom: 60px;")
      .section-header(style="margin-bottom: 30px;")
        .section-title-wrap
          span.sub-title ĐÁNH GIÁ TỪ KHÁCH HÀNG
          h2.section-title= `Khách Hàng Nói Gì Về ${product.name}`

      //- Reviews List
      if reviews && reviews.length
        .reviews-list(style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;")
          each rev in reviews
            .review-card(style="background: #FFF;")
              .review-stars
                - for (let i = 0; i < rev.rating; i++)
                  i(data-lucide="star", style="width: 14px; height: 14px; fill: #F59E0B; stroke: none;")
              p.review-quote= `“${rev.comment}”`
              .review-author
                img.author-avatar(src=rev.userAvatar, alt=rev.userName)
                .author-info
                  .author-name= rev.userName
                  .author-badge
                    i(data-lucide="check-circle", style="width: 12px; height: 12px;")
                    | Đã mua sản phẩm này
      else
        p(style="color: var(--text-muted); margin-bottom: 30px;") Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!

      //- Review Submission Box
      .write-review-card(style="background: #FFF; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 30px;")
        h3(style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px;") Gửi Đánh Giá Của Bạn
        if currentUser
          form#review-form(onsubmit="submitReview(event)")
            input(type="hidden", id="review-product-id", value=product.id)
            .form-group
              label.form-label Đánh Giá Số Sao (1 - 5 sao):
              select#review-rating.form-control(style="max-width: 200px;")
                option(value="5") ⭐⭐⭐⭐⭐ (5 sao - Tuyệt vời)
                option(value="4") ⭐⭐⭐⭐ (4 sao - Rất tốt)
                option(value="3") ⭐⭐⭐ (3 sao - Bình thường)
                option(value="2") ⭐⭐ (2 sao - Tạm được)
                option(value="1") ⭐ (1 sao - Kém)
            .form-group
              label.form-label Nhận Xét Của Bạn:
              textarea#review-comment.form-control(rows="3", placeholder="Chia sẻ cảm nhận chân thật về chất liệu, độ bền, form dáng sản phẩm...", required)
            button.btn.btn-primary(type="submit") Gửi Nhận Xét Ngay
        else
          p(style="color: var(--text-muted);")
            | Vui lòng 
            a(href=`/login?redirect=/product/${product.slug}`, style="color: var(--accent-coral); font-weight: 700; text-decoration: underline;") đăng nhập
            |  để gửi đánh giá cho sản phẩm này.

    //- 4. RELATED PRODUCTS
    if relatedProducts && relatedProducts.length
      section.section-padding
        .section-header
          .section-title-wrap
            span.sub-title GỢI Ý PHỐI ĐỒ
            h2.section-title Sản Phẩm Tương Tự
          a.section-link(href="/shop")
            | Xem thêm phụ kiện
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

        .product-grid
          each product in relatedProducts
            include ../partials/product-card

  script.
    // Helper to compare image paths (handles relative and absolute URLs)
    function isSameImage(srcA, srcB) {
      if (!srcA || !srcB) return false;
      if (srcA === srcB) return true;
      const cleanA = srcA.split('?')[0].replace(/^https?:\/\/[^\/]+/, '');
      const cleanB = srcB.split('?')[0].replace(/^https?:\/\/[^\/]+/, '');
      return cleanA === cleanB;
    }

    // Synchronize active border on left gallery thumbnails
    function syncActiveThumbnail(imgUrl) {
      if (!imgUrl) return;
      const thumbs = document.querySelectorAll('.gallery-thumb');
      thumbs.forEach(thumb => {
        const rawSrc = thumb.getAttribute('src') || thumb.src;
        const largeSrc = thumb.dataset.large || rawSrc;
        if (isSameImage(rawSrc, imgUrl) || isSameImage(largeSrc, imgUrl)) {
          thumb.classList.add('active');
          thumb.style.borderColor = '#0F172A';
        } else {
          thumb.classList.remove('active');
          thumb.style.borderColor = 'transparent';
        }
      });
    }

    // Select variant permanently (on click)
    function selectProductVariant(btn, shouldPulse = true) {
      if (!btn) return;

      document.querySelectorAll('.variant-btn').forEach(b => {
        b.classList.remove('active');
        b.style.border = '1.5px solid #CBD5E1';
        b.style.boxShadow = 'none';
      });
      btn.classList.add('active');
      btn.style.border = '2px solid #0F172A';
      btn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.06)';

      const name = btn.dataset.name;
      const price = Number(btn.dataset.price);
      const orig = Number(btn.dataset.originalPrice);
      const stock = Number(btn.dataset.stock);
      const imgUrl = btn.dataset.image;

      // 1. Update Label
      const labelEl = document.getElementById('selected-color-label');
      if (labelEl) labelEl.textContent = name;

      // 2. Update Main Price with smooth visual pulse
      const priceEl = document.getElementById('detail-price-main');
      if (priceEl && price > 0) {
        priceEl.textContent = new Intl.NumberFormat('vi-VN').format(price) + 'đ';
        if (shouldPulse) {
          priceEl.style.transform = 'scale(1.08)';
          priceEl.style.transition = 'transform 0.15s ease';
          setTimeout(() => { priceEl.style.transform = 'scale(1)'; }, 150);
        }
      }

      // 3. Update Strikethrough Price & Discount Badge
      const oldPriceEl = document.getElementById('detail-price-old');
      const badgeEl = document.getElementById('detail-discount-badge');
      if (orig > price && orig > 0) {
        if (oldPriceEl) {
          oldPriceEl.textContent = new Intl.NumberFormat('vi-VN').format(orig) + 'đ';
          oldPriceEl.style.display = 'inline-block';
        }
        if (badgeEl) {
          const disc = Math.round(((orig - price) / orig) * 100);
          badgeEl.textContent = `Tiết kiệm ${disc}%`;
          badgeEl.style.display = 'inline-block';
        }
      } else {
        if (oldPriceEl) oldPriceEl.style.display = 'none';
        if (badgeEl) badgeEl.style.display = 'none';
      }

      // 4. Update Stock Status & Quantity Spinner
      const stockEl = document.getElementById('variant-stock-status');
      const addBtn = document.getElementById('detail-add-to-cart');
      const buyBtn = document.getElementById('buy-now-btn');
      const qtyInput = document.querySelector('.qty-input');

      if (stock <= 0) {
        if (stockEl) {
          stockEl.textContent = 'Hết hàng (Tạm ngưng nhận đơn)';
          stockEl.style.color = '#DC2626';
        }
        if (addBtn) addBtn.disabled = true;
        if (buyBtn) buyBtn.disabled = true;
      } else {
        if (stockEl) {
          stockEl.textContent = `Còn ${stock} cái`;
          stockEl.style.color = '#059669';
        }
        if (addBtn) addBtn.disabled = false;
        if (buyBtn) buyBtn.disabled = false;
        if (qtyInput) {
          qtyInput.max = stock;
          if (Number(qtyInput.value) > stock) qtyInput.value = stock;
        }
      }

      // 5. Update Add To Cart dataset so cart stores exact price and variant!
      if (addBtn) {
        if (price && price > 0) {
          addBtn.dataset.price = price;
        }
        if (name) addBtn.dataset.color = name;
        if (imgUrl) addBtn.dataset.image = imgUrl;
      }

      // 6. Swap Main Image AND SYNC THE THUMBNAIL BORDER ON THE LEFT!
      if (imgUrl) {
        const mainImg = document.getElementById('main-product-img');
        if (mainImg) mainImg.src = imgUrl;
        syncActiveThumbnail(imgUrl);
      }
    }

    // Select color swatch (for non-variant products with colors)
    function selectProductColor(btn) {
      if (!btn) return;
      document.querySelectorAll('.variant-btn').forEach(b => {
        b.classList.remove('active');
        b.style.border = '1.5px solid #CBD5E1';
        b.style.boxShadow = 'none';
      });
      btn.classList.add('active');
      btn.style.border = '2px solid #0F172A';
      btn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.06)';

      const name = btn.dataset.name;
      const price = Number(btn.dataset.price);
      const imgUrl = btn.dataset.image;

      const labelEl = document.getElementById('selected-color-label');
      if (labelEl && name) labelEl.textContent = name;

      const addBtn = document.getElementById('detail-add-to-cart');
      if (addBtn) {
        if (price && price > 0) addBtn.dataset.price = price;
        if (name) addBtn.dataset.color = name;
        if (imgUrl) addBtn.dataset.image = imgUrl;
      }

      if (imgUrl) {
        const mainImg = document.getElementById('main-product-img');
        if (mainImg) mainImg.src = imgUrl;
        syncActiveThumbnail(imgUrl);
      }
    }

    // Preview variant on hover (trỏ chuột)
    function previewProductVariant(btn) {
      if (!btn) return;
      if (btn.classList.contains('active')) return;

      // Highlight this button border on hover
      btn.style.border = '2px solid #0F172A';

      const name = btn.dataset.name;
      const price = Number(btn.dataset.price);
      const orig = Number(btn.dataset.originalPrice);
      const stock = Number(btn.dataset.stock);
      const imgUrl = btn.dataset.image;

      // Preview Label
      const labelEl = document.getElementById('selected-color-label');
      if (labelEl) labelEl.textContent = name;

      // Preview Price
      const priceEl = document.getElementById('detail-price-main');
      if (priceEl && price > 0) {
        priceEl.textContent = new Intl.NumberFormat('vi-VN').format(price) + 'đ';
      }

      // Preview Stock
      const stockEl = document.getElementById('variant-stock-status');
      if (stockEl) {
        stockEl.textContent = stock <= 0 ? 'Hết hàng (Tạm ngưng)' : `Còn ${stock} cái`;
        stockEl.style.color = stock <= 0 ? '#DC2626' : '#059669';
      }

      // Preview Main Image & Move the black border to matching thumbnail!
      if (imgUrl) {
        const mainImg = document.getElementById('main-product-img');
        if (mainImg) mainImg.src = imgUrl;
        syncActiveThumbnail(imgUrl);
      }
    }

    // Restore truly active variant when mouse leaves
    function restoreProductVariant() {
      const activeBtn = document.querySelector('.variant-btn.active');
      if (activeBtn) {
        document.querySelectorAll('.variant-btn:not(.active)').forEach(b => {
          b.style.border = '1.5px solid #CBD5E1';
          b.style.boxShadow = 'none';
        });
        selectProductVariant(activeBtn, false);
      }
    }

    // Global sync: when thumbnail is clicked or hovered from main.js
    window.syncVariantFromImage = function(imgUrl) {
      if (!imgUrl) return;
      const matchingVariant = Array.from(document.querySelectorAll('.variant-btn')).find(b => isSameImage(b.dataset.image, imgUrl));
      if (matchingVariant) {
        selectProductVariant(matchingVariant);
      } else {
        syncActiveThumbnail(imgUrl);
      }
    };

    // Initialize listeners on DOM ready
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Initial sync of thumbnail border with initial active variant
      const initialActive = document.querySelector('.variant-btn.active');
      if (initialActive && initialActive.dataset.image) {
        syncActiveThumbnail(initialActive.dataset.image);
      }

      // 2. Add hover & click listeners to all left thumbnails
      const thumbs = document.querySelectorAll('.gallery-thumb');
      const mainImg = document.getElementById('main-product-img');

      thumbs.forEach(thumb => {
        thumb.addEventListener('mouseenter', () => {
          const thumbSrc = thumb.dataset.large || thumb.getAttribute('src') || thumb.src;
          syncActiveThumbnail(thumbSrc);
          if (mainImg) mainImg.src = thumbSrc;

          const matchingVariant = Array.from(document.querySelectorAll('.variant-btn')).find(b => isSameImage(b.dataset.image, thumbSrc));
          if (matchingVariant && !matchingVariant.classList.contains('active')) {
            matchingVariant.style.border = '2px solid #0F172A';
          }
        });

        thumb.addEventListener('mouseleave', () => {
          restoreProductVariant();
        });

        thumb.addEventListener('click', () => {
          const thumbSrc = thumb.dataset.large || thumb.getAttribute('src') || thumb.src;
          const matchingVariant = Array.from(document.querySelectorAll('.variant-btn')).find(b => isSameImage(b.dataset.image, thumbSrc));
          if (matchingVariant) {
            selectProductVariant(matchingVariant);
          } else {
            thumbs.forEach(t => {
              t.classList.remove('active');
              t.style.borderColor = 'transparent';
            });
            thumb.classList.add('active');
            thumb.style.borderColor = '#0F172A';
            if (mainImg) mainImg.src = thumbSrc;
          }
        });
      });
    });

    function handleBuyNow() {
      const detailBtn = document.getElementById('detail-add-to-cart');
      if (detailBtn) {
        detailBtn.click();
        setTimeout(() => { window.location.href = '/checkout'; }, 400);
      }
    }

    async function submitReview(e) {
      e.preventDefault();
      const productId = document.getElementById('review-product-id').value;
      const rating = document.getElementById('review-rating').value;
      const comment = document.getElementById('review-comment').value;

      try {
        const res = await fetch(`/api/products/${productId}/reviews`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating, comment })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Cảm ơn bạn đã gửi đánh giá!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Lỗi khi gửi đánh giá', 'error');
        }
      } catch (err) {
        showToast('Có lỗi xảy ra khi kết nối máy chủ', 'error');
      }
    }
