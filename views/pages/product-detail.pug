extends ../layouts/main

block content
  .container(style="padding-top: 24px;")
    //- Breadcrumbs
    nav(aria-label="Breadcrumb", style="margin-bottom: 24px; font-size: 0.8125rem; color: var(--text-muted);")
      a(href="/") Trang Chủ
      span(style="margin: 0 8px;") /
      a(href="/shop") Cửa Hàng
      span(style="margin: 0 8px;") /
      if category
        a(href=`/shop?category=${category.slug}`)= category.name
        span(style="margin: 0 8px;") /
      span(style="color: var(--text-main); font-weight: 600;")= product.name

    //- 1. PRODUCT DETAIL MAIN LAYOUT (Gallery + Buy Box)
    .product-detail-layout
      //- Left: Gallery Component
      .gallery-wrapper
        if product.images && product.images.length > 1
          .gallery-thumbs
            each img, idx in product.images
              img.gallery-thumb(
                src=img,
                alt=product.name,
                class=(idx === 0 ? 'active' : ''),
                data-large=img
              )
        .gallery-main
          img#main-product-img(src=product.images[0], alt=product.name)

      //- Right: Buy Box & Product Info
      .product-info-panel
        if product.categoryName
          span.sub-title(style="color: var(--accent-gold); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;")
            = product.categoryName

        h1= product.name

        //- Meta: Rating & Sold Count
        .product-meta
          .rating-stars(style="display: flex; align-items: center; gap: 4px; color: #F59E0B; font-weight: 700;")
            i(data-lucide="star", style="width: 16px; height: 16px; fill: #F59E0B; stroke: none;")
            span= product.rating
            span(style="color: var(--text-muted); font-weight: 400;")= `(${product.reviewsCount} đánh giá)`
          span •
          span= `Đã bán: ${product.soldCount}`
          span •
          span(style="color: var(--accent-emerald); font-weight: 600;") Còn hàng trong kho

        //- Price Box
        .product-detail-price
          span.detail-price-main= new Intl.NumberFormat('vi-VN').format(product.price) + 'đ'
          if product.originalPrice > product.price
            span.detail-price-old= new Intl.NumberFormat('vi-VN').format(product.originalPrice) + 'đ'
            span.badge.badge-sale= `Tiết kiệm ${product.discount}%`

        //- Color Picker
        if product.colors && product.colors.length
          .variant-picker
            .variant-title
              | Chọn Màu Sắc: 
              span#selected-color-label(style="font-weight: 400; color: var(--text-muted);")= product.colors[0].name
            .variant-swatches
              each col, idx in product.colors
                button.variant-btn(type="button", class=(idx === 0 ? 'active' : ''))
                  span(style=`display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: ${col.hex}; margin-right: 6px; vertical-align: middle;`)
                  = col.name

        //- Quantity Selector & Actions
        .quantity-row
          span(style="font-size: 0.9375rem; font-weight: 700;") Số Lượng:
          .qty-spinner
            button.qty-btn.qty-minus(type="button") -
            input.qty-input(type="number", value="1", min="1", max=product.stock, readonly)
            button.qty-btn.qty-plus(type="button") +

        .buy-actions(style="display: flex; gap: 14px; margin-bottom: 30px;")
          button#detail-add-to-cart.btn.btn-lg.btn-secondary(
            type="button",
            style="flex: 1;",
            data-id=product.id,
            data-name=product.name,
            data-price=product.price,
            data-image=product.images[0]
          )
            i(data-lucide="shopping-bag", style="width: 18px; height: 18px;")
            | Thêm Vào Giỏ Hàng

          button#buy-now-btn.btn.btn-lg.btn-primary(
            type="button",
            style="flex: 1.2;",
            onclick=`
              const detailBtn = document.getElementById('detail-add-to-cart');
              if (detailBtn) {
                detailBtn.click();
                setTimeout(() => { window.location.href = '/checkout'; }, 400);
              }
            `
          )
            i(data-lucide="zap", style="width: 18px; height: 18px; color: var(--accent-gold);")
            | Mua Ngay

        //- Coolmate-style Trust & Commitments Box
        .trust-box(style="background: var(--bg-secondary); border-radius: var(--radius-md); padding: 20px; border: 1px solid var(--border-subtle);")
          .trust-item(style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;")
            i(data-lucide="shield-check", style="width: 20px; height: 20px; color: var(--accent-emerald);")
            span(style="font-size: 0.875rem;") Cam kết 100% đúng mô tả &amp; da thật / titan 316L y tế.
          .trust-item(style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;")
            i(data-lucide="refresh-cw", style="width: 20px; height: 20px; color: var(--accent-blue);")
            span(style="font-size: 0.875rem;") Đổi trả miễn phí trong 30 ngày nếu không vừa ý.
          .trust-item(style="display: flex; align-items: center; gap: 12px;")
            i(data-lucide="gift", style="width: 20px; height: 20px; color: var(--accent-coral);")
            span(style="font-size: 0.875rem;") Tặng kèm hộp đựng cao cấp phù hợp làm quà tặng.

    //- 2. SPECIFICATIONS & DETAILED DESCRIPTION TABS
    section.section-padding(style="border-top: 1px solid var(--border-subtle); margin-top: 30px;")
      .section-header
        h2.section-title Thông Tin Chi Tiết &amp; Thông Số Kỹ Thuật

      .details-grid(style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px;")
        // Description
        .description-col
          h3(style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;") Mô Tả Sản Phẩm
          p(style="line-height: 1.8; color: #374151; margin-bottom: 20px;")= product.description

          if product.highlights && product.highlights.length
            h4(style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;") Điểm Nổi Bật Vượt Trội:
            ul(style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;")
              each hl in product.highlights
                li(style="display: flex; align-items: center; gap: 8px; font-size: 0.9375rem; color: #1F2937;")
                  i(data-lucide="check", style="width: 16px; height: 16px; color: var(--accent-emerald);")
                  span= hl

        // Specs Table
        .specs-col
          h3(style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;") Thông Số Kỹ Thuật
          table.specs-table
            tbody
              if product.specs
                tr
                  td Chất liệu
                  td= product.specs.material || 'Cao cấp'
                tr
                  td Kích thước
                  td= product.specs.dimensions || 'Tiêu chuẩn'
                tr
                  td Kiểu khóa
                  td= product.specs.lockType || 'Khóa hợp kim chống gỉ'
                tr
                  td Xuất xứ
                  td= product.specs.origin || 'Việt Nam'
                tr
                  td Chế độ bảo hành
                  td= product.specs.warranty || '12 tháng chính hãng'

    //- 3. CUSTOMER REVIEWS SECTION & SUBMISSION FORM
    section.section-padding(style="background: var(--bg-secondary); border-radius: var(--radius-lg); padding: 50px 40px; margin-bottom: 60px;")
      .section-header(style="margin-bottom: 30px;")
        .section-title-wrap
          span.sub-title ĐÁNH GIÁ TỪ KHÁCH HÀNG
          h2.section-title= `Khách Hàng Nói Gì Về ${product.name}`

      //- Reviews List
      if reviews && reviews.length
        .reviews-list(style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;")
          each rev in reviews
            .review-card(style="background: #FFF;")
              .review-stars
                - for (let i = 0; i < rev.rating; i++)
                  i(data-lucide="star", style="width: 14px; height: 14px; fill: #F59E0B; stroke: none;")
              p.review-quote= `“${rev.comment}”`
              .review-author
                img.author-avatar(src=rev.userAvatar, alt=rev.userName)
                .author-info
                  .author-name= rev.userName
                  .author-badge
                    i(data-lucide="check-circle", style="width: 12px; height: 12px;")
                    | Đã mua sản phẩm này
      else
        p(style="color: var(--text-muted); margin-bottom: 30px;") Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!

      //- Review Submission Box
      .write-review-card(style="background: #FFF; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 30px;")
        h3(style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px;") Gửi Đánh Giá Của Bạn
        if currentUser
          form#review-form(onsubmit="submitReview(event)")
            input(type="hidden", id="review-product-id", value=product.id)
            .form-group
              label.form-label Đánh Giá Số Sao (1 - 5 sao):
              select#review-rating.form-control(style="max-width: 200px;")
                option(value="5") ⭐⭐⭐⭐⭐ (5 sao - Tuyệt vời)
                option(value="4") ⭐⭐⭐⭐ (4 sao - Rất tốt)
                option(value="3") ⭐⭐⭐ (3 sao - Bình thường)
                option(value="2") ⭐⭐ (2 sao - Tạm được)
                option(value="1") ⭐ (1 sao - Kém)
            .form-group
              label.form-label Nhận Xét Của Bạn:
              textarea#review-comment.form-control(rows="3", placeholder="Chia sẻ cảm nhận chân thật về chất liệu, độ bền, form dáng sản phẩm...", required)
            button.btn.btn-primary(type="submit") Gửi Nhận Xét Ngay
        else
          p(style="color: var(--text-muted);")
            | Vui lòng 
            a(href=`/login?redirect=/product/${product.slug}`, style="color: var(--accent-coral); font-weight: 700; text-decoration: underline;") đăng nhập
            |  để gửi đánh giá cho sản phẩm này.

    //- 4. RELATED PRODUCTS
    if relatedProducts && relatedProducts.length
      section.section-padding
        .section-header
          .section-title-wrap
            span.sub-title GỢI Ý PHỐI ĐỒ
            h2.section-title Sản Phẩm Tương Tự
          a.section-link(href="/shop")
            | Xem thêm phụ kiện
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

        .product-grid
          each product in relatedProducts
            include ../partials/product-card

  script.
    async function submitReview(e) {
      e.preventDefault();
      const productId = document.getElementById('review-product-id').value;
      const rating = document.getElementById('review-rating').value;
      const comment = document.getElementById('review-comment').value;

      try {
        const res = await fetch(`/api/products/${productId}/reviews`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating, comment })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Cảm ơn bạn đã gửi đánh giá!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Lỗi khi gửi đánh giá', 'error');
        }
      } catch (err) {
        showToast('Có lỗi xảy ra khi kết nối máy chủ', 'error');
      }
    }
