extends ../layouts/main

block content
  //- 1. HERO SECTION (High Impact Cinematic Editorial Lookbook)
  section.hero-section
    .hero-bg-wrapper
      img.hero-bg(src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1920&q=85", alt="Atelier Fashion Accessories Hero")
      .hero-gradient-overlay
    
    .container
      .hero-content
        .hero-badge-wrap
          span.hero-pill-badge
            i(data-lucide="sparkles", style="width: 14px; height: 14px;")
            | BỘ SƯU TẬP THU ĐÔNG 2026 • CONTEMPORARY LUXURY
        
        h1.hero-title Tuyên Ngôn Phong Cách. Sắc Nét Từng Chi Tiết.
        
        p.hero-desc
          | Khám phá bộ sưu tập phụ kiện thời trang thủ công từ da bò Top-Grain Ý, trang sức titan 316L vĩnh cửu và nón streetwear đương đại. Định hình bản lĩnh và gu thẩm mỹ khác biệt cho thế hệ mới.
        
        .hero-cta-group
          a.btn.btn-lg.btn-primary.btn-glow(href="/shop")
            span Khám Phá Cửa Hàng
            i(data-lucide="arrow-right", style="width: 18px; height: 18px;")
          a.btn.btn-lg.btn-outline-white(href="/lookbook")
            i(data-lucide="camera", style="width: 18px; height: 18px;")
            span Xem Editorial Lookbook

        // Quick Trust Stat Strip
        .hero-trust-strip
          .trust-stat
            strong 100%
            span Da Thật &amp; Titan
          .trust-divider
          .trust-stat
            strong 60 Ngày
            span Đổi Trả Tận Nơi
          .trust-divider
          .trust-stat
            strong 50.000+
            span Khách Hàng Tin Dùng

  //- 2. USP VALUE STRIP (Coolmate / ACFC Commitments)
  section.usp-strip
    .container
      .usp-grid
        .usp-card
          .usp-card-icon
            i(data-lucide="shield-check", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title 100% Da Bò Ý &amp; Titan 316L
            .usp-card-desc Cam kết chất lượng, bảo hành 24 tháng
        .usp-card
          .usp-card-icon
            i(data-lucide="truck", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Miễn Phí Vận Chuyển Toàn Quốc
            .usp-card-desc Đơn từ 299K giao hỏa tốc 2H tại TP.HCM &amp; HN
        .usp-card
          .usp-card-icon
            i(data-lucide="refresh-cw", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Đổi Trả 60 Ngày Tận Nơi
            .usp-card-desc Đổi size, đổi mẫu dễ dàng không mất phí
        .usp-card
          .usp-card-icon
            i(data-lucide="gift", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Đóng Gói Premium Box
            .usp-card-desc Hộp quà sang trọng, có thiệp viết tay

  //- 3. FEATURED CATEGORIES SHOWCASE (YaMe & ACFC Visual Tiles)
  section.section-padding
    .container
      .section-header
        .section-title-wrap
          span.sub-title DANH MỤC PHỤ KIỆN ĐỘC QUYỀN
          h2.section-title Khám Phá Thế Giới Phụ Kiện Atelier
        a.section-link(href="/shop")
          | Xem tất cả 6 danh mục
          i(data-lucide="arrow-up-right", style="width: 16px; height: 16px;")

      .category-grid
        each cat in categories
          a.category-card(href=`/shop?category=${cat.slug}`)
            .category-card-img-wrap
              img(src=cat.image, alt=cat.name, loading="lazy")
            .category-card-overlay
              .category-card-content
                span.cat-count= `${cat.itemCount || 4}+ Thiết Kế`
                h3.cat-name= cat.name
                p.cat-desc= cat.description
                span.cat-action
                  | Mua sắm ngay
                  i(data-lucide="arrow-right", style="width: 14px; height: 14px;")

  //- 4. FLASH SALE SECTION (Countdown Timer & Sales Progress Bar)
  if flashSaleProducts && flashSaleProducts.length
    section.container.flash-sale-wrapper
      .flash-sale-box
        .flash-sale-top
          .flash-badge-area
            .flash-flame-icon
              i(data-lucide="zap", style="width: 22px; height: 22px;")
            .flash-text-wrap
              h2.flash-heading FLASH SALE TRONG NGÀY
              p.flash-sub Giảm đến 50% cho các sản phẩm hot - Số lượng có hạn
          
          .flash-timer-area
            span.timer-label KẾT THÚC SAU:
            .countdown-timer
              span.timer-box#timer-hours 08
              span.timer-colon :
              span.timer-box#timer-mins 45
              span.timer-colon :
              span.timer-box#timer-secs 20
        
        .product-grid
          each product in flashSaleProducts
            include ../partials/product-card

        .flash-sale-footer
          a.btn.btn-outline.btn-block(href="/shop?isSale=true")
            | Xem Toàn Bộ Deal Flash Sale (Giảm Đến 50%)
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

  //- 5. BEST SELLERS WITH FILTER TABS (YaMe / Coolmate Tabs)
  section.section-padding.bg-alt
    .container
      .section-header
        .section-title-wrap
          span.sub-title BÁN CHẠY NHẤT
          h2.section-title Sản Phẩm Được Săn Đón Nhiều Nhất
        
        .tab-filter-pills
          a.filter-pill.active(href="/shop") Tất Cả
          a.filter-pill(href="/shop?category=that-lung-da") Thắt Lưng
          a.filter-pill(href="/shop?category=vi-da") Ví Da
          a.filter-pill(href="/shop?category=trang-suc-titan") Trang Sức
          a.filter-pill(href="/shop?category=kinh-mat") Kính Mát

      .product-grid
        each product in bestSellerProducts
          include ../partials/product-card

      .view-more-center(style="text-align: center; margin-top: 40px;")
        a.btn.btn-lg.btn-outline(href="/shop?sort=popular")
          | Xem Thêm Sản Phẩm Bán Chạy
          i(data-lucide="arrow-right", style="width: 18px; height: 18px;")

  //- 6. SHOPPABLE EDITORIAL LOOKBOOK (Interactive Hotspots)
  section.container.section-padding-sm
    .lookbook-section
      .lookbook-wrap
        // Visual with Interactive Hotspots
        .lookbook-image-holder
          img(src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85", alt="Style Lookbook Fashion")
          
          // Hotspot 1: Sunglasses
          .lookbook-hotspot(style="top: 22%; left: 48%;", data-target="lookbook-item-1", title="Kính Mát Phi Công") 1
          
          // Hotspot 2: Titanium Necklace
          .lookbook-hotspot(style="top: 36%; left: 52%;", data-target="lookbook-item-2", title="Dây Chuyền Titan") 2
          
          // Hotspot 3: Leather Belt
          .lookbook-hotspot(style="top: 60%; left: 50%;", data-target="lookbook-item-3", title="Thắt Lưng Da Bò") 3

        // Side Content
        .lookbook-content
          .lookbook-tag
            i(data-lucide="sparkles", style="width: 14px; height: 14px;")
            | ATELIER LOOKBOOK • MIX &amp; MATCH
          h2 Hoàn Thiện Set Đồ Chuẩn Gu Cùng Phụ Kiện Sắc Sảo
          p
            | Đừng để trang phục của bạn trở nên mờ nhạt. Chỉ cần phối hợp một chiếc thắt lưng da bò Ý khóa tự động, dây chuyền Cuban titan 316L và kính râm Aviator phân cực, bạn sẽ tạo nên một diện mạo đầy quyền lực và cuốn hút.
          
          .lookbook-items-list
            #lookbook-item-1.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=200&q=80", alt="Kính Mát")
              .lookbook-item-info
                .lookbook-item-title Kính Mát Phi Công Aviator Gọng Mạ Vàng UV400
                .lookbook-item-price 299.000đ
              a.btn.btn-sm.btn-primary(href="/product/kinh-mat-phi-cong-aviator-gong-kim-loai-ma-vang-uv400") Mua ngay

            #lookbook-item-2.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=200&q=80", alt="Dây Chuyền")
              .lookbook-item-info
                .lookbook-item-title Dây Chuyền Cuban Link Titan Không Gỉ 7mm Bạc Sáng
                .lookbook-item-price 199.000đ
              a.btn.btn-sm.btn-primary(href="/product/day-chuyen-cuban-link-titan-khong-gi-7mm-bac-sang") Mua ngay

            #lookbook-item-3.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1624222247344-550fb60583dc?auto=format&fit=crop&w=200&q=80", alt="Thắt Lưng")
              .lookbook-item-info
                .lookbook-item-title Thắt Lưng Da Bò Ý Khóa Tự Động Black Onyx
                .lookbook-item-price 349.000đ
              a.btn.btn-sm.btn-primary(href="/product/that-lung-da-bo-y-khoa-tu-dong-black-onyx") Mua ngay

  //- 7. CRAFTSMANSHIP & HERITAGE (Chất Liệu & Tay Nghề Thủ Công)
  section.section-padding.craftsmanship-section
    .container
      .craft-grid
        .craft-content
          span.sub-title(style="color: var(--accent-gold);") DI SẢN CHẾ TÁC
          h2 Tỉ Mỉ Trong Từng Đường Kim, Bền Bỉ Cùng Năm Tháng
          p.craft-lead
            | Tại Atelier, chúng tôi tin rằng một món phụ kiện hoàn hảo bắt nguồn từ hai yếu tố cốt lõi: Vật liệu nguyên bản hảo hạng và đôi bàn tay của những người thợ thủ công lành nghề.
          
          .craft-features
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="layers", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 100% Da Bò Top-Grain Nhập Khẩu Ý
                p Tuyển chọn những tấm da bò đanh dẻo, giữ trọn vân da tự nhiên và càng dùng càng bóng đẹp theo thời gian.
            
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="anchor", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 Thép Titan 316L Mạ Chân Không PVD
                p Không gỉ sét, không kích ứng da, chống chịu hoàn hảo trước mồ hôi và nước hoa trong mọi điều kiện thời tiết.
            
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="scissors", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 Gia Công Viền Mép Sơn Nhiệt Tỉ Mỉ
                p Từng góc cạnh của ví và thắt lưng được mài nhẵn và quét sơn nhiệt 4 lớp chống bong tróc đạt chuẩn xuất khẩu.

          a.btn.btn-primary(href="/about", style="margin-top: 10px;")
            | Tìm Hiểu Quy Trình Chế Tác
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

        .craft-visual
          .craft-image-grid
            img.craft-img-main(src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=800&q=80", alt="Leather Crafting")
            img.craft-img-sub(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80", alt="Titanium Jewelry Crafting")

  //- 8. FASHION JOURNAL / BLOG (Tạp Chí Phối Đồ)
  section.section-padding
    .container
      .section-header
        .section-title-wrap
          span.sub-title ATELIER JOURNAL
          h2.section-title Tạp Chí Thời Trang &amp; Mẹo Phối Đồ
        a.section-link(href="/blog")
          | Xem tất cả bài viết
          i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

      .blog-grid
        article.blog-card
          .blog-thumb-wrap
            img(src="https://images.unsplash.com/photo-1624222247344-550fb60583dc?auto=format&fit=crop&w=800&q=80", alt="Blog 1")
            span.blog-category Phong Cách &amp; Phối Đồ
          .blog-info
            .blog-meta
              span.blog-date 15 Tháng 10, 2026
              span &bull;
              span.blog-read 4 phút đọc
            h3.blog-title
              a(href="/blog/5-cach-phoi-that-lung-da-bo-voi-au-phuc") 5 Cách Phối Thắt Lưng Da Bò Với Âu Phục Chuẩn Quý Ông Đương Đại
            p.blog-summary Thắt lưng không chỉ giữ trang phục chỉn chu mà còn là điểm nhấn thể hiện đẳng cấp và gu thẩm mỹ tinh tế của người đàn ông thành đạt.
            a.blog-read-more(href="/blog/5-cach-phoi-that-lung-da-bo-voi-au-phuc")
              | Đọc tiếp bài viết &rarr;

        article.blog-card
          .blog-thumb-wrap
            img(src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=800&q=80", alt="Blog 2")
            span.blog-category Xu Hướng Phụ Kiện
          .blog-info
            .blog-meta
              span.blog-date 20 Tháng 10, 2026
              span &bull;
              span.blog-read 5 phút đọc
            h3.blog-title
              a(href="/blog/xu-huong-kinh-mat-phi-cong-aviator-2026") Xu Hướng Kính Mát Phi Công Aviator &amp; Khung Kim Loại Phân Cực 2026
            p.blog-summary Chiếc kính râm Aviator huyền thoại quay trở lại mạnh mẽ trong các sàn diễn thời trang quốc tế với tròng phân cực Polarized UV400.
            a.blog-read-more(href="/blog/xu-huong-kinh-mat-phi-cong-aviator-2026")
              | Đọc tiếp bài viết &rarr;

        article.blog-card
          .blog-thumb-wrap
            img(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80", alt="Blog 3")
            span.blog-category Mẹo Phối Đồ
          .blog-info
            .blog-meta
              span.blog-date 24 Tháng 10, 2026
              span &bull;
              span.blog-read 3 phút đọc
            h3.blog-title
              a(href="/blog/nghe-thuat-mix-match-trang-suc-titan-streetwear") Nghệ Thuật Mix &amp; Match Trang Sức Titan Streetwear Cho Giới Trẻ
            p.blog-summary Từ dây chuyền Cuban link to bản đến những chiếc nhẫn họa tiết Aztec, khám phá cách tạo điểm nhấn cá tính mà không phô trương.
            a.blog-read-more(href="/blog/nghe-thuat-mix-match-trang-suc-titan-streetwear")
              | Đọc tiếp bài viết &rarr;

  //- 9. CUSTOMER REVIEWS & SOCIAL PROOF
  section.section-padding.bg-alt
    .container
      .section-header(style="text-align: center; justify-content: center; flex-direction: column; align-items: center; gap: 8px;")
        span.sub-title KHÁCH HÀNG THỰC TẾ
        h2.section-title Hơn 50.000+ Khách Hàng Đã Hài Lòng
        p(style="color: var(--text-muted); max-width: 580px; text-align: center;")
          | Sự tin yêu của cộng đồng thời trang là minh chứng rõ nhất cho chất lượng bền bỉ và dịch vụ hậu mãi chu đáo của Atelier.

      .reviews-grid
        each rev in reviews
          .review-card
            .review-stars
              - for (let i = 0; i < rev.rating; i++)
                i(data-lucide="star", style="width: 16px; height: 16px; fill: #F59E0B; stroke: none;")
            p.review-quote= `“${rev.comment}”`
            .review-author
              img.author-avatar(src=rev.userAvatar, alt=rev.userName)
              .author-info
                .author-name= rev.userName
                .author-badge
                  i(data-lucide="check-circle", style="width: 13px; height: 13px;")
                  | Đã mua hàng xác thực

  //- 10. INSTAGRAM & LOOKBOOK COMMUNITY FEED (#AtelierStyle)
  section.section-padding-sm
    .container
      .section-header(style="text-align: center; justify-content: center; flex-direction: column; align-items: center; gap: 6px;")
        span.sub-title CỘNG ĐỒNG THỜI TRANG
        h2.section-title #AtelierStyle Trên Mạng Xã Hội
        p(style="color: var(--text-muted);") Gắn thẻ @atelier.accessories để xuất hiện trên trang phục gợi ý hàng tuần của chúng tôi.

      .insta-grid
        .insta-item
          img(src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=400&q=80", alt="Insta 1")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")
        .insta-item
          img(src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=400&q=80", alt="Insta 2")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")
        .insta-item
          img(src="https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&w=400&q=80", alt="Insta 3")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")
        .insta-item
          img(src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80", alt="Insta 4")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")
        .insta-item
          img(src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=400&q=80", alt="Insta 5")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")
        .insta-item
          img(src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=400&q=80", alt="Insta 6")
          .insta-hover
            i(data-lucide="instagram", style="width: 24px; height: 24px;")

  //- 11. VIP CLUB NEWSLETTER
  section.container(style="margin-bottom: 60px;")
    .newsletter-section
      .newsletter-content
        span.newsletter-badge ĐẶC QUYỀN THÀNH VIÊN
        h2.newsletter-title Gia Nhập Câu Lạc Bộ VIP Atelier
        p.newsletter-desc
          | Đăng ký nhận thông tin ra mắt bộ sưu tập giới hạn và nhận ngay mã giảm giá 
          strong(style="color: #F59E0B;") 100.000Đ
          |  cho đơn hàng đầu tiên của bạn.
        form.newsletter-form(onsubmit="event.preventDefault(); showToast('Cảm ơn bạn! Mã voucher ATELIER100 đã gửi vào email.', 'success');")
          input(type="email", placeholder="Nhập địa chỉ email của bạn...", required)
          button.btn.btn-primary(type="submit") Nhận Voucher Ngay
