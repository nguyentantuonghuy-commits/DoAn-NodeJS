extends ../layouts/main

block content
  //- 1. FULL-WIDTH IMMERSIVE VIDEO HERO SECTION (FULL 2 BÊN)
  section.sceneai-hero-section
    // Background Looping Video (Majestic Alpine Drone Footage 4K 60fps)
    video.portal-bg-video(autoplay, loop, muted, playsinline, poster="/images/hero-poster.jpg")
      source(src="/videos/hero-campaign.mp4", type="video/mp4")
    
    // Gradient Overlay (Ensures transparent white header & center typography are razor-sharp)
    .portal-video-overlay

    // Center Hero Content (Clean, Breathable Luxury Aesthetics)
    .portal-content-center
      h1.portal-headline
        | Đẳng Cấp Phụ Kiện Nam
        br
        | Định Hình Phong Thái
      p.portal-subtext
        | Chế tác thủ công từ Da Bò Tuscany &amp; Thép Titan 316L Vĩnh Cửu.
      .portal-cta-wrap
        a.portal-btn-primary(href="/shop?sort=newest") Khám Phá Bộ Sưu Tập

  //- 2. COOLMATE-STYLE CIRCULAR CATEGORY HIGHLIGHTS BAR (STORY BUBBLES)
  section.category-stories-bar
    .container
      .stories-scroller
        a.story-circle-item(href="/shop?category=that-lung-da")
          .story-ring
            img(src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=160&q=80", alt="Thắt Lưng")
          span.story-label Thắt Lưng Ý

        a.story-circle-item(href="/shop?category=vi-da")
          .story-ring
            img(src="https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=160&q=80", alt="Ví Da")
          span.story-label Ví &amp; Cardholder

        a.story-circle-item(href="/shop?category=mu-non")
          .story-ring
            img(src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=160&q=80", alt="Mũ Nón")
          span.story-label Mũ &amp; Nón Kết

        a.story-circle-item(href="/shop?category=kinh-mat")
          .story-ring
            img(src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=160&q=80", alt="Kính Mát")
          span.story-label Kính UV400

        a.story-circle-item(href="/shop?category=trang-suc-titan")
          .story-ring
            img(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=160&q=80", alt="Trang Sức")
          span.story-label Vòng &amp; Dây Titan

        a.story-circle-item.sale-highlight(href="/shop?isSale=true")
          .story-ring.ring-sale
            .story-icon-sale
              i(data-lucide="flame", style="width: 28px; height: 28px; color: #FFF;")
          span.story-label.label-sale Flash Sale 50%

  //- 3. YAME-STYLE DUAL EDITORIAL CAMPAIGN POSTERS
  section.hero-campaign-section
    .container
      .hero-dual-grid
        // Card 1: MỚI MỞ BÁN
        a.hero-dual-card(href="/shop?sort=newest")
          img(src="https://images.unsplash.com/photo-1490578474895-699cd4e2cf59?auto=format&fit=crop&w=1200&q=85", alt="Mới Mở Bán Collection 2026", loading="eager")
          .hero-dual-overlay
            span.hero-dual-badge
              i(data-lucide="star", style="width: 13px; height: 13px;")
              | NEW ARRIVALS 2026
            h2.hero-dual-title MỚI MỞ BÁN
            p.hero-dual-desc Bộ sưu tập phụ kiện Thu Đông 2026: Tuyên ngôn phong thái tối giản Quiet Luxury với đường nét dứt khoát.
            .hero-dual-price-strip
              span.price-pill-tag Thắt lưng Da Ý Cao Cấp
              span.price-pill-tag Ví da từ 249K
              span.price-pill-tag Kính UV400 từ 199K
            span.hero-dual-btn
              | Khám Phá BST Mới
              i(data-lucide="arrow-right", style="width: 15px; height: 15px;")

        // Card 2: SALE TỪ 89.000Đ
        a.hero-dual-card(href="/shop?isSale=true")
          img(src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=1200&q=85", alt="Flash Sale Phụ Kiện Từ 89K", loading="eager")
          .hero-dual-overlay
            span.hero-dual-badge(style="color: var(--accent-coral);")
              i(data-lucide="zap", style="width: 13px; height: 13px;")
              | FLASH DEAL ĐỘC QUYỀN
            h2.hero-dual-title SALE Từ 89.000đ
            p.hero-dual-desc Ưu đãi lên tới 50% cho các thiết kế phụ kiện da thật, kính mát phân cực và trang sức titan hot nhất.
            .hero-dual-price-strip
              span.price-pill-tag(style="background: rgba(225, 29, 72, 0.3);") Đồng giá 89K
              span.price-pill-tag Phụ kiện dưới 199K
              span.price-pill-tag Combo Giảm Thêm 10%
            span.hero-dual-btn
              | Săn Deal Ngay
              i(data-lucide="arrow-right", style="width: 15px; height: 15px;")

  //- 4. VALUE PROPOSITION STRIP (Commitments & Guarantees)
  section.usp-strip
    .container
      .usp-grid
        .usp-card
          .usp-card-icon
            i(data-lucide="shield-check", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title 100% Da Bò Ý &amp; Titan 316L
            .usp-card-desc Cam kết chất lượng chuẩn xuất khẩu, bảo hành 24 tháng 1 đổi 1
        .usp-card
          .usp-card-icon
            i(data-lucide="truck", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Giao Hàng Hỏa Tốc Toàn Quốc
            .usp-card-desc Giao hàng hỏa tốc trong 2H tại TP.HCM &amp; Hà Nội
        .usp-card
          .usp-card-icon
            i(data-lucide="refresh-cw", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Đổi Trả 60 Ngày Tận Nơi
            .usp-card-desc Đổi size, đổi mẫu dễ dàng không mất phí, shipper đến tận nhà
        .usp-card
          .usp-card-icon
            i(data-lucide="gift", style="width: 24px; height: 24px;")
          .usp-card-info
            .usp-card-title Hộp Quà Signature Sang Trọng
            .usp-card-desc Đóng gói chỉn chu có túi vải canvas &amp; thiệp viết tay

  //- 3. ACFC-STYLE CATEGORY FILTER NAVIGATION STRIP
  section.container(style="margin-top: 36px; margin-bottom: 20px;")
    .tab-filter-pills(style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none;")
      a.filter-pill.active(href="/shop") 
        i(data-lucide="grid", style="width: 14px; height: 14px; margin-right: 5px;")
        | Tất Cả Phụ Kiện
      a.filter-pill(href="/shop?category=that-lung-da")
        i(data-lucide="shield", style="width: 14px; height: 14px; margin-right: 5px;")
        | Thắt Lưng Da Bò Ý
      a.filter-pill(href="/shop?category=vi-da")
        i(data-lucide="credit-card", style="width: 14px; height: 14px; margin-right: 5px;")
        | Ví &amp; Cardholder RFID
      a.filter-pill(href="/shop?category=mu-non")
        i(data-lucide="disc", style="width: 14px; height: 14px; margin-right: 5px;")
        | Mũ &amp; Nón Streetwear
      a.filter-pill(href="/shop?category=kinh-mat")
        i(data-lucide="glasses", style="width: 14px; height: 14px; margin-right: 5px;")
        | Kính Mát UV400
      a.filter-pill(href="/shop?category=trang-suc-titan")
        i(data-lucide="link", style="width: 14px; height: 14px; margin-right: 5px;")
        | Trang Sức Titan 316L
      a.filter-pill(href="/shop?category=tui-balo")
        i(data-lucide="briefcase", style="width: 14px; height: 14px; margin-right: 5px;")
        | Túi Đeo Chéo &amp; Balo

  //- 4. FLASH SALE SECTION (Countdown Timer & Sales Progress Bar)
  if flashSaleProducts && flashSaleProducts.length
    section.container.flash-sale-wrapper
      .flash-sale-box
        .flash-sale-top
          .flash-badge-area
            .flash-flame-icon
              i(data-lucide="zap", style="width: 22px; height: 22px;")
            .flash-text-wrap
              h2.flash-heading FLASH SALE TRONG NGÀY
              p.flash-sub Giảm đến 50% cho các sản phẩm hot nhất - Số lượng giới hạn
          
          .flash-timer-area
            span.timer-label KẾT THÚC SAU:
            .countdown-timer
              span.timer-box#timer-hours 08
              span.timer-colon :
              span.timer-box#timer-mins 45
              span.timer-colon :
              span.timer-box#timer-secs 20
        
        .product-grid
          each product in flashSaleProducts
            include ../partials/product-card

        .flash-sale-footer
          a.btn.btn-outline.btn-block(href="/shop?isSale=true")
            | Xem Toàn Bộ Deal Flash Sale (Giảm Đến 50%)
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

  //- 5. PUCINI-STYLE 3-PORTRAIT SHOWCASE SECTION ("EXPERIENCE A WHOLE NEW ERA")
  section.pucini-showcase-section
    .container
      .pucini-header
        .pucini-eyebrow EXPERIENCE A WHOLE NEW ACCESSORIES ERA
        h2.pucini-title New design. New ATELIER.
        p.pucini-desc
          | Mỗi đường nét được tinh giản đến mức tối đa để tôn vinh chất liệu nguyên bản và phong thái đĩnh đạc của quý ông đương đại.

      .pucini-grid
        // Portrait Card 1: Tuscan Leather Texture
        a.pucini-card(href="/shop?category=that-lung-da")
          img(src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=800&q=85", alt="Tuscany Leather Texture", loading="lazy")
          .pucini-card-overlay
            span.pucini-card-badge TUSCANY LEATHER
            h3.pucini-card-title Da Bò Thảo Mộc Nguyên Bản
            p.pucini-card-sub Tuyển chọn từ những tấm da đanh dẻo nhất vùng Tuscany, càng dùng càng bóng đẹp theo năm tháng.

        // Portrait Card 2: Modern Gentleman Lifestyle
        a.pucini-card(href="/lookbook")
          img(src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=85", alt="Modern Gentleman Style", loading="lazy")
          .pucini-card-overlay
            span.pucini-card-badge SIGNATURE LIFESTYLE
            h3.pucini-card-title Phong Thái Quiet Luxury
            p.pucini-card-sub Tự tin và đĩnh đạc trong mọi khoảnh khắc với phụ kiện chuẩn mực được gia công tinh xảo.

        // Portrait Card 3: Titanium & Coastal Outdoors
        a.pucini-card(href="/shop?category=trang-suc-titan")
          img(src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=800&q=85", alt="Titanium Cuban Jewelry", loading="lazy")
          .pucini-card-overlay
            span.pucini-card-badge TIMELESS TITANIUM
            h3.pucini-card-title Thép Titan 316L Bất Diệt
            p.pucini-card-sub Chống ăn mòn tuyệt đối, không gỉ sét trước mồ hôi và nước biển trong mọi chuyến phiêu lưu.

  //- 6. "MỚI MỞ BÁN" SHOWCASE (NEW ARRIVALS - YaMe & ACFC Style)
  section.section-padding
    .container
      .section-header
        .section-title-wrap
          span.sub-title MỚI MỞ BÁN • NEW ARRIVALS 2026
          h2.section-title Bộ Sưu Tập Phụ Kiện Vừa Ra Mắt
        a.section-link(href="/shop?sort=newest")
          | Xem tất cả hàng mới
          i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

      .product-grid
        if newArrivalProducts && newArrivalProducts.length
          each product in newArrivalProducts
            include ../partials/product-card
        else if featuredProducts && featuredProducts.length
          each product in featuredProducts
            include ../partials/product-card

  //- 7. FEATURED CATEGORIES SHOWCASE (YaMe & ACFC Visual Tiles)
  section.section-padding.bg-alt
    .container
      .section-header
        .section-title-wrap
          span.sub-title DANH MỤC PHỤ KIỆN ĐỘC QUYỀN
          h2.section-title Khám Phá Thế Giới Phụ Kiện Atelier
        a.section-link(href="/shop")
          | Xem tất cả 6 danh mục
          i(data-lucide="arrow-up-right", style="width: 16px; height: 16px;")

      .category-grid
        each cat in categories
          a.category-card(href=`/shop?category=${cat.slug}`)
            .category-card-img-wrap
              img(src=cat.image, alt=cat.name, loading="lazy")
            .category-card-overlay
              .category-card-content
                span.cat-count= `${cat.itemCount || 4}+ Thiết Kế`
                h3.cat-name= cat.name
                p.cat-desc= cat.description
                span.cat-action
                  | Mua sắm ngay
                  i(data-lucide="arrow-right", style="width: 14px; height: 14px;")

  //- 8. BEST SELLERS WITH FILTER TABS (YaMe / Coolmate Tabs)
  section.section-padding
    .container
      .section-header
        .section-title-wrap
          span.sub-title BÁN CHẠY NHẤT
          h2.section-title Sản Phẩm Được Săn Đón Nhiều Nhất
        
        .tab-filter-pills
          a.filter-pill.active(href="/shop") Tất Cả
          a.filter-pill(href="/shop?category=that-lung-da") Thắt Lưng
          a.filter-pill(href="/shop?category=vi-da") Ví Da
          a.filter-pill(href="/shop?category=trang-suc-titan") Trang Sức
          a.filter-pill(href="/shop?category=kinh-mat") Kính Mát

      .product-grid
        each product in bestSellerProducts
          include ../partials/product-card

      .view-more-center(style="text-align: center; margin-top: 40px;")
        a.btn.btn-lg.btn-outline(href="/shop?sort=popular")
          | Xem Thêm Sản Phẩm Bán Chạy
          i(data-lucide="arrow-right", style="width: 18px; height: 18px;")

  //- 9. SHOPPABLE EDITORIAL LOOKBOOK (Interactive Hotspots)
  section.container.section-padding-sm
    .lookbook-section
      .lookbook-wrap
        // Visual with Interactive Hotspots
        .lookbook-image-holder
          img(src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85", alt="Style Lookbook Fashion")
          
          // Hotspot 1: Sunglasses
          .lookbook-hotspot(style="top: 22%; left: 48%;", data-target="lookbook-item-1", title="Kính Mát Phi Công") 1
          
          // Hotspot 2: Titanium Necklace
          .lookbook-hotspot(style="top: 36%; left: 52%;", data-target="lookbook-item-2", title="Dây Chuyền Titan") 2
          
          // Hotspot 3: Leather Belt
          .lookbook-hotspot(style="top: 60%; left: 50%;", data-target="lookbook-item-3", title="Thắt Lưng Da Bò") 3

        // Side Content
        .lookbook-content
          .lookbook-tag
            i(data-lucide="sparkles", style="width: 14px; height: 14px;")
            | ATELIER LOOKBOOK • MIX &amp; MATCH
          h2 Hoàn Thiện Set Đồ Chuẩn Gu Cùng Phụ Kiện Sắc Sảo
          p
            | Đừng để trang phục của bạn trở nên mờ nhạt. Chỉ cần phối hợp một chiếc thắt lưng da bò Ý khóa tự động, dây chuyền Cuban titan 316L và kính râm Aviator phân cực, bạn sẽ tạo nên một diện mạo đầy quyền lực và cuốn hút.
          
          .lookbook-items-list
            #lookbook-item-1.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=200&q=80", alt="Kính Mát")
              .lookbook-item-info
                .lookbook-item-title Kính Mát Phi Công Aviator Gọng Mạ Vàng UV400
                .lookbook-item-price 299.000đ
              a.btn.btn-sm.btn-primary(href="/product/kinh-mat-phi-cong-aviator-gong-kim-loai-ma-vang-uv400") Mua ngay

            #lookbook-item-2.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=200&q=80", alt="Dây Chuyền")
              .lookbook-item-info
                .lookbook-item-title Dây Chuyền Cuban Link Titan Không Gỉ 7mm Bạc Sáng
                .lookbook-item-price 199.000đ
              a.btn.btn-sm.btn-primary(href="/product/day-chuyen-cuban-link-titan-khong-gi-7mm-bac-sang") Mua ngay

            #lookbook-item-3.lookbook-item-card
              img.lookbook-item-thumb(src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=200&q=80", alt="Thắt Lưng")
              .lookbook-item-info
                .lookbook-item-title Thắt Lưng Da Bò Ý Khóa Tự Động Black Onyx
                .lookbook-item-price 349.000đ
              a.btn.btn-sm.btn-primary(href="/product/that-lung-da-bo-y-khoa-tu-dong-black-onyx") Mua ngay

  //- 10. CRAFTSMANSHIP & HERITAGE (Chất Liệu & Tay Nghề Thủ Công)
  section.section-padding.craftsmanship-section
    .container
      .craft-grid
        .craft-content
          span.sub-title(style="color: var(--accent-gold);") DI SẢN CHẾ TÁC
          h2 Tỉ Mỉ Trong Từng Đường Kim, Bền Bỉ Cùng Năm Tháng
          p.craft-lead
            | Tại Atelier, chúng tôi tin rằng một món phụ kiện hoàn hảo bắt nguồn từ hai yếu tố cốt lõi: Vật liệu nguyên bản hảo hạng và đôi bàn tay của những người thợ thủ công lành nghề.
          
          .craft-features
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="layers", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 100% Da Bò Top-Grain Nhập Khẩu Ý
                p Tuyển chọn những tấm da bò đanh dẻo, giữ trọn vân da tự nhiên và càng dùng càng bóng đẹp theo thời gian.
            
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="anchor", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 Thép Titan 316L Mạ Chân Không PVD
                p Không gỉ sét, không kích ứng da, chống chịu hoàn hảo trước mồ hôi và nước hoa trong mọi điều kiện thời tiết.
            
            .craft-feature-item
              .craft-feature-icon
                i(data-lucide="scissors", style="width: 22px; height: 22px;")
              .craft-feature-text
                h4 Gia Công Viền Mép Sơn Nhiệt Tỉ Mỉ
                p Từng góc cạnh của ví và thắt lưng được mài nhẵn và quét sơn nhiệt 4 lớp chống bong tróc đạt chuẩn xuất khẩu.

          a.btn.btn-primary(href="/about", style="margin-top: 10px;")
            | Tìm Hiểu Quy Trình Chế Tác
            i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

        .craft-visual
          .craft-image-grid
            img.craft-img-main(src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=800&q=80", alt="Leather Crafting")
            img.craft-img-sub(src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80", alt="Titanium Jewelry Crafting")

  //- 11. FASHION JOURNAL / BLOG (Tạp Chí Phối Đồ)
  section.section-padding.bg-alt
    .container
      .section-header
        .section-title-wrap
          span.sub-title ATELIER JOURNAL
          h2.section-title Tạp Chí Thời Trang &amp; Mẹo Phối Đồ
        a.section-link(href="/blog")
          | Xem tất cả bài viết
          i(data-lucide="arrow-right", style="width: 16px; height: 16px;")

      .blog-grid
        article.blog-card
          .blog-thumb-wrap
            img(src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=800&q=80", alt="Blog 1")
            span.blog-category Phong Cách &amp; Phối Đồ
          .blog-info
            .blog-meta
              span.blog-date 15 Tháng 10, 2026
              span &bull;
              span.blog-read 4 phút đọc
            h3.blog-title
              a(href="/blog/5-cach-phoi-that-lung-da-bo-voi-au-phuc") 5 Cách Phối Thắt Lưng Da Bò Với Âu Phục Chuẩn Quý Ông Đương Đại
            p.blog-summary Thắt lưng không chỉ giữ trang phục chỉn chu mà còn là điểm nhấn thể hiện đẳng cấp và gu thẩm mỹ tinh tế của người đàn ông thành đạt.
            a.blog-read-more(href="/blog/5-cach-phoi-that-lung-da-bo-voi-au-phuc")
              | Đọc tiếp bài viết &rarr;

        article.blog-card
          .blog-thumb-wrap
            img(src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=800&q=80", alt="Blog 2")
            span.blog-category Xu Hướng Phụ Kiện
          .blog-info
            .blog-meta
              span.blog-date 20 Tháng 10, 2026
              span &bull;
              span.blog-read 5 phút đọc
            h3.blog-title
              a(href="/blog/xu-huong-kinh-mat-phi-cong-aviator-2026") Xu Hướng Kính Mát Phi Công Aviator &amp; Khung Kim Loại Phân Cực 2026
