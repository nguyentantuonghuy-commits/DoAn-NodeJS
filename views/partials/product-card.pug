//- Reusable Product Card Component
.product-card(
  data-id=product.id,
  data-name=product.name,
  data-price=product.price,
  data-image=product.images[0],
  data-color=(product.colors && product.colors.length ? product.colors[0].name : 'Tiêu chuẩn')
)
  //- Thumbnail with dual-image hover effect
  .product-thumb
    a(href=`/product/${product.slug}`)
      img.primary-img(src=product.images[0], alt=product.name)
      if product.images[1]
        img.hover-img(src=product.images[1], alt=product.name)
      else
        img.hover-img(src=product.images[0], alt=product.name)

    //- Status Badges
    .product-badges
      if product.isSale
        span.badge.badge-sale= `-${product.discount}%`
      if product.isFeatured
        span.badge.badge-hot HOT
      if product.stock <= 5 && product.stock > 0
        span.badge(style="background: #FEF3C7; color: #92400E;") SẮP HẾT

    //- Quick Action Buttons on Hover
    .product-actions
      a.quick-view-btn(href=`/product/${product.slug}`, title="Xem chi tiết")
        i(data-lucide="eye")
        span Xem chi tiết
      button.quick-add-btn(type="button", title="Thêm nhanh vào giỏ")
        i(data-lucide="plus")
        span Thêm giỏ

  //- Color Swatches (Biến thể có giá riêng hoặc màu thông thường)
  if product.hasVariants && product.variants && product.variants.length > 1
    .color-swatches
      each v, idx in product.variants
        span.swatch-dot(
          class=(idx === 0 ? 'active' : ''),
          style=`background-color: ${v.color || '#000000'};`,
          title=`${v.name}: ${new Intl.NumberFormat('vi-VN').format(v.price)} đ`
        )
  else if product.colors && product.colors.length > 1
    .color-swatches
      each color, idx in product.colors
        span.swatch-dot(
          class=(idx === 0 ? 'active' : ''),
          style=`background-color: ${color.hex};`,
          title=color.name,
          data-img=color.image
        )

  //- ACFC-style Promo Ribbon
  .card-promo-ribbon
    if product.isSale
      span Freeship + Giảm thêm đến 199K
    else if product.price >= 400000
      span Mua 2 Giảm 10% • Tặng Hộp Quà
    else
      span Đổi trả 60 ngày • Bảo hành 24 tháng

  //- Brand & Title
  .product-brand-line
    span.product-brand-name ATELIER COUTURE
    span.product-category-tag= product.categoryName || 'Phụ kiện'
  a(href=`/product/${product.slug}`)
    h3.product-title= product.name

  //- Price Row
  .product-price-row
    if product.hasVariants && product.variants && product.variants.length > 1
      span.current-price= 'Từ ' + new Intl.NumberFormat('vi-VN').format(product.price) + ' đ'
    else
      span.current-price= new Intl.NumberFormat('vi-VN').format(product.price) + ' đ'
    if product.originalPrice > product.price
      span.original-price= new Intl.NumberFormat('vi-VN').format(product.originalPrice) + ' đ'
      span.discount-rate= `-${product.discount}%`

  //- Sold Count Progress for Flash Sale items
  if product.isSale
    .sales-progress
      .progress-track
        .progress-fill(style=`width: ${Math.min(95, Math.floor((product.soldCount / (product.soldCount + product.stock)) * 100))}%`)
      .progress-label
        span= `Đã bán ${product.soldCount}`
        span(style="color: var(--accent-coral); font-weight: 700;") Sắp hết hàng
