//- Master Header & Navigation (Clean Luxury Top Bar)
header.site-header#main-header(class=(currentPath === '/' ? 'home-header' : ''))
  .container.header-inner
    // Mobile Hamburger Trigger
    button.mobile-menu-toggle#mobile-menu-btn(type="button", aria-label="Mở menu di động")
      i(data-lucide="menu", style="width: 24px; height: 24px;")

    // Brand Logo
    a.brand-logo(href="/")
      .brand-logo-mark
        span.logo-icon A
      .brand-logo-text
        span.logo-main ATELIER
        span.logo-sub CONTEMPORARY ACCESSORIES

    // Desktop Navigation Menu with Multi-Category Dropdowns (YaMe & ACFC Style)
    nav.main-nav
      a.nav-link(href="/", class=(currentPath === '/' ? 'active' : '')) 
        | Trang Chủ

      // 1. SALE with Mega Dropdown
      .nav-item.has-mega-dropdown(class=(query && query.openDropdown === 'sale' ? 'is-active' : ''))
        a.nav-link.sale-tag.dropdown-trigger(href="/shop?isSale=true", class=(query && query.isSale ? 'active' : ''))
          i(data-lucide="flame", style="width: 14px; height: 14px; margin-right: 4px; vertical-align: -1px;")
          | SALE
          i(data-lucide="chevron-down", style="width: 13px; height: 13px; margin-left: 2px;")
        
        .mega-dropdown-menu
          .container.mega-dropdown-inner
            .mega-col
              .mega-col-title
                i(data-lucide="zap", style="width: 15px; height: 15px; color: var(--accent-coral);")
                | CHƯƠNG TRÌNH HOT
              ul.mega-links
                li: a(href="/shop?isSale=true")
                  span.link-name Flash Sale Đang Diễn Ra
                  span.link-badge(style="background: var(--accent-coral); color: #FFF;") -50%
                li: a(href="/shop?isSale=true")
                  span.link-name Mua 2 Giảm Thêm 10%
                li: a(href="/shop?isSale=true")
                  span.link-name Combo Phụ Kiện Tiết Kiệm
                li: a(href="/shop?isSale=true")
                  span.link-name Xả Kho Đón Bộ Sưu Tập Mới
                li: a.view-all-sub(href="/shop?isSale=true") Xem toàn bộ deal sốc &rarr;

            .mega-col
