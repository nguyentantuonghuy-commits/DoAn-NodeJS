//- 1. Top Announcement Bar (Ticker)
.announcement-bar
  .container
    .announcement-inner
      .announcement-ticker
        span.ticker-item
          span.badge-pill FREESHIP
          | MIỄN PHÍ VẬN CHUYỂN TOÀN QUỐC CHO ĐƠN HÀNG TỪ 299.000Đ
        span.ticker-sep •
        span.ticker-item
          span.badge-pill CAM KẾT
          | 100% DA BÒ Ý THẬT &amp; TITAN 316L BẢO HÀNH 24 THÁNG
        span.ticker-sep •
        span.ticker-item
          span.badge-pill YÊN TÂM
          | ĐỔI TRẢ 60 NGÀY TẬN NƠI MIỄN PHÍ - KHÔNG CẦN LÝ DO
        span.ticker-sep •
        span.ticker-item
          span.badge-pill HOTLINE
          | 1900 8888 (08:00 - 22:00)
      
      .announcement-right
        a.ann-link(href="/contact")
          i(data-lucide="map-pin", style="width: 13px; height: 13px;")
          | Hệ Thống Cửa Hàng
        span.divider |
        a.ann-link(href="/blog")
          i(data-lucide="book-open", style="width: 13px; height: 13px;")
          | Tạp Chí Thời Trang

//- 2. Master Header & Navigation
header.site-header#main-header
  .container.header-inner
    // Mobile Hamburger Trigger
    button.mobile-menu-toggle#mobile-menu-btn(type="button", aria-label="Mở menu di động")
      i(data-lucide="menu", style="width: 24px; height: 24px;")

    // Brand Logo
    a.brand-logo(href="/")
      .brand-logo-mark
        span.logo-icon A
      .brand-logo-text
        span.logo-main ATELIER
        span.logo-sub CONTEMPORARY ACCESSORIES

    // Desktop Navigation Menu with Mega Dropdown
    nav.main-nav
      a.nav-link(href="/", class=(currentPath === '/' ? 'active' : '')) 
        | Trang Chủ

      // Shop with Mega Dropdown
      .nav-item.has-mega-dropdown
        a.nav-link.dropdown-trigger(href="/shop", class=(currentPath.startsWith('/shop') ? 'active' : ''))
          | Cửa Hàng
          i(data-lucide="chevron-down", style="width: 14px; height: 14px; margin-left: 2px;")
        
        // Mega Dropdown Menu Panel
        .mega-dropdown-menu
          .container.mega-dropdown-inner
            .mega-col
              .mega-col-title
                i(data-lucide="shield", style="width: 16px; height: 16px;")
                | ĐỒ DA THỦ CÔNG
              ul.mega-links
                li: a(href="/shop?category=that-lung-da")
                  span.link-name Thắt Lưng Da Bò Ý
                  span.link-badge Hot
                li: a(href="/shop?category=vi-da")
                  span.link-name Ví Da &amp; Cardholder
                li: a(href="/shop?category=tui-balo")
                  span.link-name Túi Đeo Chéo &amp; Balo Da
                li: a.view-all-sub(href="/shop?category=that-lung-da") Khám phá toàn bộ đồ da &rarr;

            .mega-col
              .mega-col-title
                i(data-lucide="sparkles", style="width: 16px; height: 16px;")
                | PHỤ KIỆN ĐƯƠNG ĐẠI
              ul.mega-links
                li: a(href="/shop?category=mu-non")
                  span.link-name Mũ &amp; Nón Streetwear
                li: a(href="/shop?category=kinh-mat")
                  span.link-name Kính Mát Phi Công UV400
                  span.link-badge New
                li: a(href="/shop?category=trang-suc-titan")
                  span.link-name Trang Sức Titan 316L
                li: a.view-all-sub(href="/shop") Xem tất cả phụ kiện &rarr;

            .mega-col
              .mega-col-title
                i(data-lucide="flame", style="width: 16px; height: 16px;")
                | XU HƯỚNG &amp; BỘ SƯU TẬP
              ul.mega-links
                li: a(href="/shop?sort=newest")
                  span.link-name Hàng Mới Về (New Arrivals)
                li: a(href="/shop?sort=popular")
                  span.link-name Bán Chạy Nhất (Best Sellers)
                li: a(href="/shop?isSale=true", style="color: var(--accent-coral); font-weight: 600;")
                  span.link-name Flash Sale Đang Diễn Ra
                  span.link-badge(style="background: var(--accent-coral); color: #fff;") -50%
                li: a(href="/lookbook")
                  span.link-name Editorial Lookbook 2026

            // Mega Banner Promo Card
            .mega-promo-col
              a.mega-promo-card(href="/shop?isSale=true")
                img(src="https://images.unsplash.com/photo-1624222247344-550fb60583dc?auto=format&fit=crop&w=600&q=80", alt="Flash Sale Promo")
                .mega-promo-overlay
                  span.promo-badge FLASH DEAL
                  h4 Giảm Đến 50% Phụ Kiện Da Thật
                  span.promo-cta Săn Ngay &rarr;

      a.nav-link(href="/lookbook", class=(currentPath === '/lookbook' ? 'active' : ''))
        | Lookbook

      a.nav-link.sale-tag(href="/shop?isSale=true", class=(query && query.isSale ? 'active' : ''))
        i(data-lucide="flame", style="width: 14px; height: 14px; margin-right: 3px; vertical-align: -1px;")
        | Flash Sale

      a.nav-link(href="/blog", class=(currentPath.startsWith('/blog') ? 'active' : ''))
        | Tạp Chí

      a.nav-link(href="/about", class=(currentPath === '/about' ? 'active' : ''))
        | Về Atelier

      a.nav-link(href="/contact", class=(currentPath === '/contact' ? 'active' : ''))
        | Showroom

    // Header Actions (Smart Search, Wishlist, Cart, User)
    .header-actions
      // Smart Search Bar
      .header-search-wrapper
        form.header-search(action="/shop", method="GET")
          span.search-icon
            i(data-lucide="search", style="width: 17px; height: 17px;")
          input#header-search-input(type="text", name="search", placeholder="Tìm phụ kiện, thắt lưng...", value=(query && query.search ? query.search : ''), autocomplete="off")
          if query && query.search
            a.search-clear(href="/shop", title="Xóa tìm kiếm") &times;
        
        // Search Quick Tags Suggestion Popup
        .search-suggestions#search-suggestions
          .suggestion-group
            .suggestion-title
              i(data-lucide="trending-up", style="width: 13px; height: 13px;")
              | Tìm kiếm phổ biến:
            .suggestion-tags
              a.tag-pill(href="/shop?search=thắt lưng") Thắt lưng da Ý
              a.tag-pill(href="/shop?search=ví da") Ví da Bifold
              a.tag-pill(href="/shop?search=kính mát") Kính phi công
              a.tag-pill(href="/shop?search=titan") Dây chuyền titan
              a.tag-pill(href="/shop?search=mũ") Nón snapback

      // Cart Button with Drawer Trigger
      a.action-btn.cart-btn(href="/cart", title="Giỏ hàng của bạn")
        i(data-lucide="shopping-bag", style="width: 21px; height: 21px;")
        span.badge-count.accent.cart-count-badge(style="display: none;") 0

      // User Menu (Customer or Admin)
      if currentUser
        .user-menu-wrapper
          button.action-btn.user-avatar-btn(type="button", title="Tài khoản cá nhân")
            img(src=currentUser.avatar, alt=currentUser.name)
          .user-dropdown
            .user-dropdown-header
              .user-avatar-mini
                img(src=currentUser.avatar, alt=currentUser.name)
              .user-meta
                .user-name= currentUser.name
                .user-role= currentUser.role === 'admin' ? 'Quản Trị Viên (Admin)' : 'Thành Viên VIP'
            
            .user-dropdown-body
              if currentUser.role === 'admin'
                a.dropdown-item.admin-link(href="/admin")
                  i(data-lucide="layout-dashboard", style="width: 16px; height: 16px;")
                  | Bảng Điều Khiển Admin
                a.dropdown-item(href="/admin/products")
                  i(data-lucide="package", style="width: 16px; height: 16px;")
                  | Quản Lý Sản Phẩm
                a.dropdown-item(href="/admin/orders")
                  i(data-lucide="shopping-cart", style="width: 16px; height: 16px;")
                  | Quản Lý Đơn Hàng
              
              a.dropdown-item(href="/profile")
                i(data-lucide="user", style="width: 16px; height: 16px;")
                | Tài Khoản &amp; Đơn Hàng
              a.dropdown-item(href="/cart")
                i(data-lucide="shopping-bag", style="width: 16px; height: 16px;")
                | Xem Giỏ Hàng
            
            .user-dropdown-footer
              a.dropdown-item.logout-link(href="/logout")
                i(data-lucide="log-out", style="width: 16px; height: 16px;")
                | Đăng Xuất
      else
        .auth-btns
          a.btn.btn-sm.btn-outline(href="/login") Đăng Nhập
          a.btn.btn-sm.btn-primary.hide-mobile(href="/register") Đăng Ký

// Mobile Navigation Drawer
.mobile-drawer#mobile-drawer
  .mobile-drawer-overlay#mobile-drawer-overlay
  .mobile-drawer-content
    .mobile-drawer-header
      a.brand-logo(href="/")
        span.logo-main ATELIER
        span.logo-sub ACCESSORIES
      button.close-drawer-btn#close-drawer-btn(type="button")
        i(data-lucide="x", style="width: 22px; height: 22px;")
    
    .mobile-drawer-search
      form(action="/shop", method="GET")
        input(type="text", name="search", placeholder="Tìm sản phẩm...")
        button(type="submit")
          i(data-lucide="search", style="width: 18px; height: 18px;")

    .mobile-nav-links
      a.mobile-nav-item(href="/") Trang Chủ
      
      .mobile-accordion
        .mobile-accordion-title#shop-accordion-btn
          span Cửa Hàng &amp; Danh Mục
          i(data-lucide="chevron-down", style="width: 16px; height: 16px;")
        .mobile-accordion-content#shop-accordion-content
          a(href="/shop") &bull; Tất Cả Sản Phẩm
          a(href="/shop?category=that-lung-da") &bull; Thắt Lưng Da Bò Ý
          a(href="/shop?category=vi-da") &bull; Ví Da &amp; Cardholder
          a(href="/shop?category=mu-non") &bull; Mũ &amp; Nón Streetwear
          a(href="/shop?category=kinh-mat") &bull; Kính Mát Phi Công UV400
          a(href="/shop?category=trang-suc-titan") &bull; Trang Sức Titan 316L
          a(href="/shop?category=tui-balo") &bull; Túi Đeo Chéo &amp; Balo
      
      a.mobile-nav-item(href="/lookbook") Bộ Sưu Tập Lookbook
      a.mobile-nav-item.highlight(href="/shop?isSale=true") Flash Sale -50%
      a.mobile-nav-item(href="/blog") Tạp Chí Phối Đồ
      a.mobile-nav-item(href="/about") Về Chúng Tôi
      a.mobile-nav-item(href="/contact") Hệ Thống Cửa Hàng

    .mobile-drawer-footer
      if currentUser
        .mobile-user-card
          img(src=currentUser.avatar, alt=currentUser.name)
          .mobile-user-info
            .name= currentUser.name
            a(href="/profile") Quản lý tài khoản &rarr;
        a.btn.btn-outline.btn-block(href="/logout", style="margin-top: 10px;") Đăng Xuất
      else
        a.btn.btn-primary.btn-block(href="/login", style="margin-bottom: 8px;") Đăng Nhập
        a.btn.btn-outline.btn-block(href="/register") Tạo Tài Khoản
