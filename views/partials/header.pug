        | Tạp Chí

      a.nav-link.nav-link-secondary(href="/contact", class=(currentPath === '/contact' ? 'active' : ''))
        | Showroom

      a.nav-link.nav-track-link(href="/track-order", class=(currentPath === '/track-order' ? 'active' : ''), style="font-weight: 600;")
