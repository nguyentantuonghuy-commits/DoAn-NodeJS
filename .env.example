PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pw1yuva.mongodb.net/atelier_db?retryWrites=true&w=majority

# Cấu hình gửi mail OTP qua Google Gmail (Mật khẩu ứng dụng - Google App Password)
# Xem hướng dẫn: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cấu hình Google OAuth 2.0 (Đăng nhập bằng Google)
# Lấy Client ID & Secret từ: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
